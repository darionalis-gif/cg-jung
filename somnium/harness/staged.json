{"alta-263":{"title":"The Man in the Raincoat","mood":"A quiet dusk street turned suddenly hostile: singled out by a stranger's rage for no reason at all.","world":{"sky":"dusk","skyColor":"#6d6a8c","horizonColor":"#c28a63","fogColor":"#7c7590","fogDensity":0.012,"ground":"stone","groundColor":"#6b6a70","ambient":"#4a4e68","sunColor":"#e6b184","sunIntensity":0.8,"sunDir":[-0.5,0.35,-0.8],"weather":"none","stars":false},"actors":[{"id":"main_street","kind":"road","label":"the street","color":"#43444a","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":8,"depth":90}},{"id":"cross_street","kind":"road","label":"the corner","color":"#43444a","size":1,"pos":[0,0,24],"yaw":90,"detail":{"width":8,"depth":90}},{"id":"shop_left_one","kind":"shop","label":"shops","color":"#8d8272","size":1,"pos":[-11,0,-10],"yaw":90,"detail":{"text":"SHOP","second":"#d6c08a"}},{"id":"shop_left_two","kind":"shop","label":"","color":"#7d7f86","size":1,"pos":[-11,0,4],"yaw":90,"detail":{"text":"CAFE","second":"#cbb27e"}},{"id":"shop_right_one","kind":"shop","label":"","color":"#8a7a76","size":1,"pos":[11,0,-14],"yaw":270,"detail":{"text":"BAKERY","second":"#d3bb8c"}},{"id":"shop_right_two","kind":"shop","label":"","color":"#79808a","size":1,"pos":[11,0,0],"yaw":270,"detail":{"text":"NEWS","second":"#cfae7c"}},{"id":"shop_right_three","kind":"house","label":"","color":"#877d70","size":1,"pos":[11,0,14],"yaw":270,"detail":{"second":"#5b4a44"}},{"id":"lamp_one","kind":"lamp","label":"street lamps","color":"#4b4c52","size":1,"pos":[-5.5,0,-12],"yaw":90,"glow":true,"detail":{"height":4}},{"id":"lamp_two","kind":"lamp","label":"","color":"#4b4c52","size":1,"pos":[-5.5,0,2],"yaw":90,"glow":true,"detail":{"height":4}},{"id":"lamp_three","kind":"lamp","label":"","color":"#4b4c52","size":1,"pos":[5.5,0,-6],"yaw":270,"glow":true,"detail":{"height":4}},{"id":"lamp_four","kind":"lamp","label":"","color":"#4b4c52","size":1,"pos":[5.5,0,10],"yaw":270,"glow":true,"detail":{"height":4}},{"id":"me","kind":"person","label":"me","color":"#4a5a7a","size":1,"pos":[0,0,-10],"yaw":0,"detail":{"skin":"#d9b394","hair":"#4a3a2e"}},{"id":"raincoat_man","kind":"person","label":"the loud man in the raincoat, hands stuck in his pockets","color":"#2c3a30","size":1.05,"pos":[2,0,22],"yaw":180,"hidden":true,"detail":{"second":"#1d2620","skin":"#d0a382","hair":"#3a2f26"}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#6c6a74","size":1,"pos":[-6.5,0,-3],"yaw":90,"hidden":true,"detail":{"count":5,"radius":2.2}}],"beats":[{"dur":8,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":18,"height":7,"angle":150},"actions":[{"actor":"me","move":[0,0,-6],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"There are shops, etc., and street lamps.","camera":{"mode":"fixed","target":"me","pos":[0,4.5,-17],"lookAt":[0,2,3]},"actions":[{"actor":"me","move":[0,0,-2],"path":"line","yaw":0,"state":"walk"}]},{"dur":10,"text":"I'm walking down the street, about to turn a corner, and I'm confronted by a loud man in a raincoat","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":165},"actions":[{"actor":"me","move":[0,0,10],"path":"line","yaw":0,"state":"walk"},{"actor":"raincoat_man","at":0.45,"for":0.25,"appear":true},{"actor":"raincoat_man","at":0.45,"move":[1.5,0,12.5],"path":"arc","yaw":180,"state":"walk"}]},{"dur":6,"text":"- he's really mad about something but I don't know what.","camera":{"mode":"orbit","target":"raincoat_man","distance":6,"height":2.5,"angle":25},"actions":[{"actor":"raincoat_man","yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"effect":"pulse","at":0.15}]},{"dur":9,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder","camera":{"mode":"follow","target":"me","distance":6.5,"height":2.4,"angle":60},"actions":[{"actor":"raincoat_man","move":[0.7,0,11.7],"path":"line","yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"effect":"quake","at":0.55}]},{"dur":5,"text":"- he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"raincoat_man","distance":4.5,"height":2,"angle":10},"actions":[{"actor":"raincoat_man","yaw":180,"state":"idle"},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":8,"text":"I retreat up the street a bit","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":170},"actions":[{"actor":"me","move":[0,0,1],"path":"line","yaw":0,"state":"walk"},{"actor":"raincoat_man","yaw":180,"state":"shake"}]},{"dur":6,"text":"- there are some people out watching.","camera":{"mode":"wide","target":"me","distance":15,"height":6,"angle":95},"actions":[{"actor":"watchers","at":0.1,"for":0.25,"appear":true},{"actor":"watchers","yaw":90,"state":"idle"},{"actor":"me","yaw":0,"state":"idle"},{"actor":"raincoat_man","yaw":180,"state":"shake"}]},{"dur":6,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"orbit","target":"watchers","distance":8,"height":3.2,"angle":30},"actions":[{"actor":"watchers","state":"idle"},{"actor":"me","yaw":0,"state":"idle"},{"actor":"raincoat_man","yaw":180,"state":"shake"},{"world":{"fogDensity":0.015}}]},{"dur":9,"text":"He follows and keeps yelling at me","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":175},"actions":[{"actor":"me","move":[0,0,-5],"path":"line","yaw":0,"state":"walk"},{"actor":"raincoat_man","move":[1.2,0,-2.5],"path":"line","yaw":180,"state":"walk"}]},{"dur":8,"text":"- some of the time he yells around in general but it's mostly at me","camera":{"mode":"orbit","target":"raincoat_man","distance":7,"height":3,"angle":40},"actions":[{"actor":"raincoat_man","for":0.35,"yaw":90,"state":"shake"},{"actor":"raincoat_man","at":0.35,"for":0.25,"yaw":250,"state":"shake"},{"actor":"raincoat_man","at":0.6,"yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":10,"text":"- I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"wide","target":"me","distance":18,"height":7,"angle":100},"actions":[{"actor":"raincoat_man","move":[1.2,0,-4],"path":"line","yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"actor":"watchers","state":"idle"},{"world":{"skyColor":"#6d6a8c","horizonColor":"#9a6f57","fogColor":"#6a6480","fogDensity":0.018,"ambient":"#3f4462","sunIntensity":0.5}},{"effect":"pulse","at":0.8}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"Frozen exhaustion and unheard grief: a company of lame men limping toward help that is not there.","world":{"sky":"overcast","skyColor":"#b6c3d0","horizonColor":"#dde6ec","fogColor":"#ccd7de","fogDensity":0.008,"ground":"snow","groundColor":"#eef4f8","ambient":"#6b7688","sunColor":"#ffffff","sunIntensity":1,"sunDir":[0.3,0.5,-0.6],"weather":"snow","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#5c6650","size":1,"pos":[-4,0,-28],"yaw":0,"detail":{"second":"#3f4a38","skin":"#d8b191","hair":"#4a3a2a"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#5c6650","size":1,"pos":[3,0,-29],"yaw":0,"detail":{"count":16,"radius":4,"second":"#3f4a38"}},{"id":"mountains_far","kind":"mountain","label":"Antarctica","color":"#c9d6e0","size":1,"pos":[0,0,190],"yaw":0},{"id":"mountains_side","kind":"mountain","label":"","color":"#c2d0dc","size":0.8,"pos":[-160,0,120],"yaw":40},{"id":"aid_station","kind":"house","label":"the aid station","color":"#7d8a93","size":1,"pos":[0,0,10],"yaw":180,"detail":{"second":"#5a6670"}},{"id":"aid_sign","kind":"sign","label":"","color":"#8f9aa2","size":1,"pos":[6,0,4],"yaw":180,"detail":{"text":"SICK CALL"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#dfe6ea","size":1,"pos":[-1,0,5],"yaw":180,"hidden":true,"detail":{"count":5,"radius":2,"second":"#9fb0bb"}},{"id":"medic","kind":"person","label":"a kind, middle-aged black medic","color":"#e6ecef","size":1,"pos":[-7,0,2],"yaw":155,"hidden":true,"detail":{"second":"#b9c6cd","skin":"#5a3b2a","hair":"#2b2320"}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#5c6650","size":1,"pos":[-11,0,-7],"yaw":20,"hidden":true,"detail":{"second":"#3f4a38","skin":"#d6ac89","hair":"#6b4a2c"}}],"beats":[{"dur":10,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"wide","target":"me","distance":26,"height":9,"angle":150},"actions":[{"actor":"me","move":[-4,0,-18],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[3,0,-19],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":25},"actions":[{"actor":"me","yaw":55,"state":"idle"},{"actor":"platoon","yaw":340,"state":"idle"},{"actor":"aid_sign","at":0.3,"color":"#c8d3d9"},{"effect":"pulse","at":0.35}]},{"dur":12,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"wide","target":"platoon","distance":30,"height":10,"angle":110},"actions":[{"actor":"me","move":[-4,0,-2],"path":"line","yaw":0,"state":"limp"},{"actor":"platoon","move":[3,0,-3],"path":"line","yaw":0,"state":"limp"},{"actor":"staff","at":0.6,"for":0.25,"state":"idle","appear":true},{"world":{"fogColor":"#c3ced7","fogDensity":0.012,"sunIntensity":0.85}}]},{"dur":9,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"fixed","target":"staff","pos":[-15,7,-12],"lookAt":"staff"},"actions":[{"actor":"platoon","move":[0,0,1],"path":"line","state":"push"},{"actor":"staff","state":"shake"},{"actor":"me","yaw":20,"state":"idle"},{"effect":"quake","at":0.5}]},{"dur":8,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"orbit","target":"me","distance":5,"height":2.5,"angle":20},"actions":[{"actor":"me","yaw":0,"state":"kneel"},{"actor":"platoon","state":"idle"},{"actor":"staff","state":"idle"},{"world":{"skyColor":"#96a4b3","horizonColor":"#b7c3cc","fogColor":"#9fabba","fogDensity":0.017,"groundColor":"#dfe6ee","ambient":"#4a5570","sunIntensity":0.55}}]},{"dur":10,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"follow","target":"me","distance":6.5,"height":2.6,"angle":60},"actions":[{"actor":"medic","for":0.25,"yaw":155,"state":"idle","appear":true},{"actor":"me","yaw":333,"state":"idle"},{"actor":"medic","at":0.3,"say":"Timmy D. will go home."},{"actor":"timmy","at":0.55,"for":0.25,"yaw":20,"state":"idle","appear":true},{"world":{"fogDensity":0.014,"ambient":"#586480","sunIntensity":0.75}}]},{"dur":9,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"follow","target":"me","distance":6,"height":2.4,"angle":65},"actions":[{"actor":"me","for":0.5,"move":[-9,0,-5],"path":"line","yaw":200,"state":"limp"},{"actor":"timmy","yaw":30,"state":"idle"},{"actor":"timmy","at":0.6,"say":"I have been denied sick call."},{"world":{"fogColor":"#a3aebc","fogDensity":0.018,"sunIntensity":0.6}}]},{"dur":8,"text":"He has seen no one.","camera":{"mode":"orbit","target":"timmy","distance":7,"height":3,"angle":30},"actions":[{"actor":"medic","at":0.15,"for":0.25,"vanish":true},{"actor":"staff","at":0.2,"for":0.25,"vanish":true},{"actor":"platoon","at":0.3,"for":0.25,"vanish":true},{"actor":"timmy","at":0.35,"say":"I have seen no one."},{"actor":"me","yaw":200,"state":"idle"},{"effect":"blur","at":0.5},{"world":{"skyColor":"#8d9aab","fogColor":"#98a4b4","fogDensity":0.024,"ambient":"#454f6a","sunIntensity":0.45}}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"warm party chatter curdling into helpless shame as the body comes apart mid-sentence","world":{"sky":"night","skyColor":"#12121f","horizonColor":"#2c2130","fogColor":"#2b2436","fogDensity":0.006,"ground":"floor","groundColor":"#6b4f38","ambient":"#5c5468","sunColor":"#ffd9a8","sunIntensity":0.9,"sunDir":[0.3,1,0.2