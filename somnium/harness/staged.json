e ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":6,"height":1.8,"angle":155},"actions":[{"actor":"puddle_1","at":0.05,"for":0.25,"appear":true},{"actor":"puddle_2","at":0.1,"for":0.25,"appear":true},{"actor":"puddle_3","at":0.12,"for":0.25,"appear":true},{"actor":"me","move":[0,0,9],"path":"line","state":"walk"},{"at":0.3,"effect":"blur"}]},{"dur":8,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"orbit","target":"me","distance":6.5,"height":2.4,"angle":55},"actions":[{"actor":"boy","at":0.05,"for":0.25,"state":"idle","appear":true},{"actor":"me","for":0.6,"move":[0.2,0,12.6],"path":"line","yaw":20,"state":"walk"},{"actor":"me","at":0.6,"state":"idle"},{"actor":"boy","at":0.65,"state":"wave"}]},{"dur":7,"text":"He says he has seen me before","camera":{"mode":"orbit","target":"boy","distance":5,"height":2,"angle":45},"actions":[{"actor":"boy","yaw":-145.49,"state":"idle","say":"I've seen you before."},{"actor":"me","yaw":20,"state":"idle"}]},{"dur":7,"text":"and remembers especially the big lens on my camera.","camera":{"mode":"orbit","target":"me","distance":4.2,"height":1.7,"angle":40},"actions":[{"actor":"boy","state":"idle","say":"I remember the big lens on your camera."},{"actor":"big_lens","at":0.2,"glow":true},{"at":0.25,"effect":"pulse"}]},{"dur":8,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"orbit","target":"boy","distance":4.5,"height":1.8,"angle":35},"actions":[{"actor":"boy","state":"idle","say":"I'll bet you are not bothered by poor light."},{"world":{"ambient":"#4a5378","sunIntensity":0.6}}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"follow","target":"me","distance":10,"height":3.5,"angle":180},"actions":[{"actor":"house_a","at":0.05,"for":0.25,"appear":true},{"actor":"house_b","at":0.05,"for":0.25,"appear":true},{"actor":"house_c","at":0.08,"for":0.25,"appear":tr