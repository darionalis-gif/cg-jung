{"alta-263":{"title":"The Man in the Raincoat","mood":"A dull grey street where a stranger's anger fastens onto you for no reason at all.","world":{"sky":"overcast","skyColor":"#9ba4ae","horizonColor":"#b4b9bd","fogColor":"#a9aeb3","fogDensity":0.012,"ground":"stone","groundColor":"#8d8d8a","ambient":"#5b6272","sunColor":"#cfd4d8","sunIntensity":0.9,"sunDir":[0.3,0.85,-0.35],"weather":"none","stars":false},"actors":[{"id":"main_street","kind":"road","label":"","color":"#4b4b4f","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":8,"depth":120}},{"id":"cross_street","kind":"road","label":"the corner","color":"#4b4b4f","size":1,"pos":[0,0,18],"yaw":90,"detail":{"width":8,"depth":120}},{"id":"shop_bakery","kind":"shop","label":"a shop","color":"#b9a893","size":1,"pos":[-10,0,-18],"yaw":90,"detail":{"text":"BAKERY","second":"#7d5f46"}},{"id":"shop_grocer","kind":"shop","label":"a shop","color":"#a7b2a4","size":1,"pos":[-10,0,-4],"yaw":90,"detail":{"text":"GROCER","second":"#5f6f5c"}},{"id":"shop_hardware","kind":"shop","label":"a shop","color":"#b0a7b6","size":1,"pos":[-10,0,10],"yaw":90,"detail":{"text":"HARDWARE","second":"#6a6270"}},{"id":"shop_chemist","kind":"shop","label":"a shop","color":"#bdb49c","size":1,"pos":[10,0,-11],"yaw":270,"detail":{"text":"CHEMIST","second":"#7a705a"}},{"id":"shop_cafe","kind":"shop","label":"a shop","color":"#a9b6bd","size":1,"pos":[10,0,3],"yaw":270,"detail":{"text":"CAFE","second":"#5d6b73"}},{"id":"shop_corner","kind":"shop","label":"a shop","color":"#b5aa9e","size":1,"pos":[10,0,17],"yaw":270,"detail":{"text":"NEWSAGENT","second":"#6e6255"}},{"id":"lamp_a","kind":"lamp","label":"street lamps","color":"#5a5f63","size":1,"pos":[-5.2,0,-14],"yaw":90,"glow":true,"detail":{"height":4.5}},{"id":"lamp_b","kind":"lamp","label":"","color":"#5a5f63","size":1,"pos":[5.2,0,-4],"yaw":270,"glow":true,"detail":{"height":4.5}},{"id":"lamp_c","kind":"lamp","label":"","color":"#5a5f63","size":1,"pos":[-5.2,0,6],"yaw":90,"glow":true,"detail":{"height":4.5}},{"id":"lamp_d","kind":"lamp","label":"","color":"#5a5f63","size":1,"pos":[5.2,0,14],"yaw":270,"glow":true,"detail":{"height":4.5}},{"id":"parked_car","kind":"car","label":"","color":"#7c8288","size":1,"pos":[3.2,0,-16],"yaw":0},{"id":"me","kind":"person","label":"me","color":"#4d5a6b","size":1,"pos":[-1,0,-22],"yaw":0,"detail":{"skin":"#d8b191","hair":"#3a2e26"}},{"id":"raincoat_man","kind":"person","label":"a loud man in a raincoat","color":"#3e4a3a","size":1.05,"pos":[1.6,0,14],"yaw":180,"hidden":true,"detail":{"second":"#2b3328","skin":"#cf9f80","hair":"#4a4038"}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#6f6f78","size":1,"pos":[-6,0,-3],"yaw":90,"hidden":true,"detail":{"count":5,"radius":2}},{"id":"far_watcher","kind":"person","label":"someone watching","color":"#7a7068","size":1,"pos":[6,0,-1],"yaw":250,"hidden":true,"detail":{"skin":"#c99a7c","hair":"#6a6058"}}],"beats":[{"dur":7,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":26,"height":11,"angle":200},"actions":[{"actor":"me","yaw":0,"state":"idle"}]},{"dur":6,"text":"There are shops, etc., and street lamps.","camera":{"mode":"fixed","target":"me","pos":[-15,6,-24],"lookAt":[0,2,-6]},"actions":[{"actor":"me","move":[-1,0,-17],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"I'm walking down the street, about to turn a corner,","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":180},"actions":[{"actor":"me","move":[-0.8,0,6],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"and I'm confronted by a loud man in a raincoat -","camera":{"mode":"follow","target":"me","distance":7.5,"height":2.6,"angle":190},"actions":[{"actor":"raincoat_man","at":0.05,"for":0.25,"appear":true},{"actor":"raincoat_man","at":0.15,"move":[0.2,0,10.4],"path":"line","yaw":180,"state":"walk"},{"actor":"me","for":0.5,"move":[-0.6,0,8.4],"path":"line","yaw":0,"state":"walk"},{"actor":"me","at":0.55,"state":"idle"},{"effect":"pulse","at":0.5}]},{"dur":7,"text":"he's really mad about something but I don't know what.","camera":{"mode":"orbit","target":"raincoat_man","distance":5,"height":2.2,"angle":20},"actions":[{"actor":"raincoat_man","state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"skyColor":"#8d939c","fogDensity":0.016,"ambient":"#4f5566"}}]},{"dur":8,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder -","camera":{"mode":"follow","target":"me","distance":6,"height":2.2,"angle":200},"actions":[{"actor":"raincoat_man","for":0.45,"state":"shake"},{"actor":"raincoat_man","at":0.45,"for":0.3,"move":[-0.3,0,9.6],"path":"line","yaw":180,"state":"push"},{"actor":"raincoat_man","at":0.78,"move":[0.1,0,10.2],"path":"line","state":"shake"},{"actor":"me","state":"idle"},{"effect":"quake","at":0.5}]},{"dur":6,"text":"he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"raincoat_man","distance":3.6,"height":1.9,"angle":15},"actions":[{"actor":"raincoat_man","state":"shake"}]},{"dur":8,"text":"I retreat up the street a bit - there are some people out watching.","camera":{"mode":"follow","target":"me","distance":9,"height":3.4,"angle":150},"actions":[{"actor":"me","move":[-0.8,0,0],"path":"line","yaw":0,"state":"walk"},{"actor":"watchers","at":0.35,"for":0.25,"appear":true},{"actor":"far_watcher","at":0.45,"for":0.25,"appear":true},{"actor":"watchers","state":"idle"},{"actor":"raincoat_man","state":"shake"}]},{"dur":7,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"fixed","target":"me","pos":[8.5,4.5,-8],"lookAt":[-3,1.6,-1]},"actions":[{"actor":"watchers","yaw":60,"state":"idle"},{"actor":"far_watcher","yaw":250,"state":"idle"},{"actor":"me","yaw":20,"state":"idle"},{"world":{"fogColor":"#9ba0a6","ambient":"#4a5062"}}]},{"dur":8,"text":"He follows and keeps yelling at me -","camera":{"mode":"follow","target":"me","distance":8,"height":2.8,"angle":160},"actions":[{"actor":"raincoat_man","move":[0.6,0,3.2],"path":"line","yaw":180,"state":"walk"},{"actor":"raincoat_man","at":0.7,"state":"shake"},{"actor":"me","move":[-1,0,-1.6],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"some of the time he yells around in general but it's mostly at me -","camera":{"mode":"orbit","target":"raincoat_man","distance":7,"height":3,"angle":40},"actions":[{"actor":"raincoat_man","for":0.35,"yaw":90,"state":"shake"},{"actor":"raincoat_man","at":0.35,"for":0.25,"yaw":250,"state":"shake"},{"actor":"raincoat_man","at":0.6,"yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"actor":"watchers","state":"idle"}]},{"dur":10,"text":"I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"wide","target":"me","distance":22,"height":12,"angle":120},"actions":[{"actor":"raincoat_man","state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"skyColor":"#868d96","horizonColor":"#a2a7ab","fogDensity":0.02,"ambient":"#454b5e","sunIntensity":0.6}}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"Frozen, aching loyalty and the grief of not being heard.","world":{"sky":"overcast","skyColor":"#c6d2e0","horizonColor":"#e6edf4","fogColor":"#dde6ef","fogDensity":0.008,"ground":"snow","groundColor":"#e9f0f8","ambient":"#6e7b93","sunColor":"#fff4e2","sunIntensity":1.1,"sunDir":[0.3,0.6,-0.5],"weather":"snow","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#4a5240","size":1,"pos":[0,0,-4],"yaw":0,"detail":{"second":"#2f3629","skin":"#d8b08a","hair":"#4a3a2a"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#4a5240","size":1,"pos":[4,0,-2],"yaw":0,"detail":{"count":16,"radius":4,"second":"#2f3629"}},{"id":"aid_station","kind":"house","label":"the aid station","color":"#d7dce4","size":1,"pos":[0,0,24],"yaw":180,"detail":{"second":"#8c99a8"}},{"id":"sick_call_sign","kind":"sign","label":"","color":"#7d6a52","size":1,"pos":[-6,0,20],"yaw":180,"detail":{"text":"SICK CALL"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#e4e7ea","size":1,"pos":[0,0,19],"yaw":180,"hidden":true,"detail":{"count":5,"radius":2,"second":"#b4bcc6"}},{"id":"medic","kind":"person","label":"the kind medic","color":"#3f4a3c","size":1,"pos":[-3.5,0,16],"yaw":90,"hidden":true,"detail":{"second":"#dfe4e8","skin":"#4a3325","hair":"#26201c"}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#4a5240","size":1,"pos":[7,0,14],"yaw":270,"hidden":true,"detail":{"second":"#2f3629","skin":"#d9b48f","hair":"#6b4a2a"}},{"id":"peaks_west","kind":"mountain","label":"","color":"#c9d5e2","size":1,"pos":[-70,0,180],"yaw":0},{"id":"peaks_east","kind":"mountain","label":"","color":"#c3d0de","size":1.2,"pos":[100,0,200],"yaw":0},{"id":"ice_ridge","kind":"cliff","label":"","color":"#dbe6f0","size":1,"pos":[-40,0,60],"yaw":20,"detail":{"width":40,"depth":16,"height":12}}],"beats":[{"dur":7,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"follow","target":"me","distance":10,"height":3.5,"angle":165},"actions":[{"actor":"me","move":[0,0,2],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[4,0,4],"path":"line","yaw":0,"state":"walk"}]},{"dur":6,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"orbit","target":"platoon","distance":11,"height":3,"angle":30},"actions":[{"actor":"platoon","yaw":0,"state":"idle"},{"actor":"me","yaw":0,"state":"idle"},{"actor":"sick_call_sign","state":"idle"}]},{"dur":10,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":150},"actions":[{"actor":"platoon","move":[6,0,15],"path":"line","yaw":0,"state":"limp"},{"actor":"me","move":[0,0,16],"path":"line","yaw":0,"state":"limp"},{"world":{"fogDensity":0.012,"ambient":"#5f6c85","sunIntensity":0.9}}]},{"dur":8,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"fixed","target":"staff","pos":[-13,4.5,18],"lookAt":"staff"},"actions":[{"actor":"staff","for":0.25,"state":"shake","appear":true},{"actor":"platoon","move":[5,0,17.5],"path":"line","state":"limp"},{"actor":"me","move":[0,0,17],"path":"line","yaw":0,"state":"idle"},{"effect":"pulse","at":0.55}]},{"dur":8,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"wide","target":"me","distance":22,"height":11,"angle":140},"actions":[{"actor":"me","yaw":0,"state":"kneel"},{"actor":"staff","state":"shake"},{"actor":"platoon","state":"idle"},{"world":{"skyColor":"#93a3b8","horizonColor":"#c3cddb","fogColor":"#c2ccd9","fogDensity":0.018,"groundColor":"#d5dee9","ambient":"#4b5670","sunIntensity":0.6}}]},{"dur":10,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"follow","target":"me","distance":6,"height":2.5,"angle":25},"actions":[{"actor":"medic","for":0.25,"yaw":90,"state":"idle","appear":true},{"actor":"me","yaw":270,"state":"idle"},{"actor":"medic","at":0.25,"for":0.6,"say":"Timmy D. will go home."},{"actor":"timmy","at":0.55,"move":[7,0,14],"state":"limp","appear":true},{"world":{"ambient":"#5d6a83","sunIntensity":0.8}}]},{"dur":8,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"follow","target":"me","distance":7,"height":2.5,"angle":40},"actions":[{"actor":"me","for":0.5,"move":[5.4,0,14.5],"path":"line","yaw":90,"state":"walk"},{"actor":"timmy","yaw":270,"state":"idle"},{"actor":"timmy","at":0.55,"say":"I have been denied sick call."}]},{"dur":8,"text":"He has seen no one.","camera":{"mode":"orbit","target":"timmy","distance":5,"height":2.2,"angle":15},"actions":[{"actor":"timmy","at":0.15,"for":0.6,"say":"I have seen no one."},{"actor":"timmy","state":"idle"},{"actor":"staff","at":0.5,"for":0.25,"vanish":true},{"actor":"medic","at":0.6,"for":0.25,"vanish":true},{"world":{"skyColor":"#8695ab","fogColor":"#b9c4d2","fogDensity":0.024,"ambient":"#48536d","sunIntensity":0.5}},{"effect":"blur","at":0.7}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"A warm crowded party that turns, mid-sentence, into quiet bodily horror.","world":{"sky":"night","skyColor":"#171a2c","horizonColor":"#2b2438","fogColor":"#2e2836","fogDensity":0.007,"ground":"floor","groundColor":"#6b5647","ambient":"#5a5570","sunColor":"#ffd7a8","sunIntensity":1.1,"sunDir":[0.3,0.9,-0.4],"weather":"none","stars":false},"actors":[{"id":"hall","kind":"room","label":"","color":"#7a6754","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":44,"depth":20,"height":4.5,"second":"#8e7a63"}},{"id":"tea_table","kind":"table","label":"an extremely long tea table","color":"#c3ae90","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":30,"depth":1.2,"second":"#e6ded0"}},{"id":"party_crowd","kind":"crowd","label":"many people","color":"#6f6a8c","size":1,"pos":[0,0,-2.8],"yaw":0,"detail":{"count":26,"radius":13,"skin":"#d3a884"}},{"id":"guests_near","kind":"crowd","label":"","color":"#7d6f6a","size":1,"pos":[-9,0,2.8],"yaw":180,"detail":{"count":14,"radius":6,"skin":"#c99b78"}},{"id":"me","kind":"person","label":"me","color":"#4d6a8c","size":1,"pos":[4,0,2.6],"yaw":0,"detail":{"skin":"#d8ab8a","hair":"#3b2b22"}},{"id":"young_man","kind":"person","label":"a man about my age, 20-25","color":"#8c5b4a","size":1,"pos":[2.5,0,4.6],"yaw":180,"hidden":true,"detail":{"skin":"#c99b78","hair":"#241a15"}},{"id":"young_woman","kind":"person","label":"a woman about my age, 20-25","color":"#b0838f","size":1,"pos":[5.6,0,4.6],"yaw":180,"hidden":true,"detail":{"skin":"#e0b493","hair":"#5a3a24"}},{"id":"tooth_1","kind":"tooth","label":"my tooth","color":"#f5efe0","size":2.5,"pos":[4,1.55,2.95],"yaw":0,"hidden":true},{"id":"tooth_2","kind":"tooth","label":"","color":"#f2ead8","size":2.5,"pos":[4.15,1.55,2.95],"yaw":0,"hidden":true},{"id":"tooth_3","kind":"tooth","label":"","color":"#efe4cf","size":2.5,"pos":[3.85,1.55,2.95],"yaw":0,"hidden":true},{"id":"tooth_4","kind":"tooth","label":"","color":"#ece0c8","size":2.5,"pos":[4.3,1.52,2.95],"yaw":0,"hidden":true},{"id":"tooth_5","kind":"tooth","label":"","color":"#e8dabf","size":2.5,"pos":[3.7,1.52,2.95],"yaw":0,"hidden":true}],"beats":[{"dur":7,"text":"I dreamed I was at a party.","camera":{"mode":"wide","target":"me","distance":15,"height":5,"angle":25},"actions":[{"actor":"me","state":"idle"},{"actor":"party_crowd","state":"dance"},{"actor":"guests_near","state":"idle"}]},{"dur":7,"text":"There were many people crowded around","camera":{"mode":"orbit","target":"party_crowd","distance":12,"height":4,"angle":40},"actions":[{"actor":"party_crowd","state":"dance"},{"actor":"guests_near","state":"wave"},{"actor":"me","state":"idle"}]},{"dur":8,"text":"an extremely long tea table.","camera":{"mode":"wide","target":"tea_table","distance":16,"height":5,"angle":90},"actions":[{"actor":"tea_table","state":"idle"},{"actor":"party_crowd","state":"idle"},{"actor":"guests_near","state":"idle"},{"world":{"ambient":"#5f5872","sunIntensity":1}}]},{"dur":9,"text":"As I started to talk to the people who were about my age (M & F 20-25)","camera":{"mode":"follow","target":"me","distance":6.5,"height":2.5,"angle":45},"actions":[{"actor":"young_man","for":0.25,"state":"idle","appear":true},{"actor":"young_woman","for":0.25,"state":"idle","appear":true},{"actor":"me","yaw":0,"state":"wave"},{"actor":"young_man","at":0.4,"state":"wave"},{"actor":"young_woman","at":0.4,"state":"idle"}]},{"dur":8,"text":"my teeth began to drop out.","camera":{"mode":"follow","target":"me","distance":4.5,"height":2.1,"angle":10},"actions":[{"actor":"tooth_1","at":0.15,"move":[3.95,0,3.5],"path":"line","state":"fall","appear":true},{"actor":"me","at":0.1,"state":"shake"},{"actor":"young_man","state":"idle"},{"actor":"young_woman","state":"idle"},{"world":{"fogColor":"#332b38","fogDensity":0.011,"ambient":"#4a4a68"}},{"effect":"pulse","at":0.15}]},{"dur":11