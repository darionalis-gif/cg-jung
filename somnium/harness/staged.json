8"}},{"id":"slum_house_3","kind":"house","label":"","color":"#8a7b62","size":0.9,"pos":[-12,0,15],"yaw":90,"detail":{"second":"#6a5340"}},{"id":"slum_shop","kind":"shop","label":"","color":"#7a6b55","size":0.9,"pos":[11,0,-10],"yaw":270,"detail":{"text":"SHOP","second":"#5d4b39"}},{"id":"slum_house_4","kind":"house","label":"","color":"#86755d","size":0.85,"pos":[11,0,4],"yaw":270,"detail":{"second":"#63503c"}},{"id":"slum_house_5","kind":"house","label":"","color":"#7f7059","size":0.9,"pos":[12,0,21],"yaw":270,"detail":{"second":"#5e4a37"}},{"id":"me","kind":"person","label":"me","color":"#4a5a78","size":1,"pos":[-1,0,-18],"yaw":0,"detail":{"skin":"#c9a184","hair":"#33261c"}},{"id":"ann","kind":"person","label":"Ann","color":"#a45e6e","size":0.96,"pos":[1.4,0,-18],"yaw":0,"detail":{"wear":"coat","wearColor":"#a45e6e","skin":"#d3ab8c","hair":"#4a3122"}},{"id":"the_money","kind":"bag","label":"money on my person","color":"#c9a227","size":0.7,"pos":[0,0,0],"yaw":0,"carriedBy":"me"},{"id":"steve","kind":"person","label":"my brother Steve","color":"#3f6b5a","size":1.02,"pos":[1.6,0,-5],"yaw":0,"hidden":true,"detail":{"wear":"jacket","wearColor":"#3f6b5a","skin":"#c9a184","hair":"#2b2018"}},{"id":"the_hole","kind":"pit","label":"a manhole","color":"#3a332c","size":1,"pos":[0,0,12],"yaw":0,"detail":{"radius":1.6,"height":4}},{"id":"the_grating","kind":"box","label":"the grating","color":"#5b5b60","size":1,"pos":[2.7,0,12],"yaw":0,"ghost":true,"detail":{"width":3.6,"depth":3.6,"height":0.3}},{"id":"the_weeds","kind":"flower","label":"a lot of weeds","color":"#6d7d3c","size":1,"pos":[4.4,0,12],"yaw":0,"detail":{"count":26,"radius":1.7,"second":"#8a9450"}},{"id":"the_rock","kind":"rock","label":"a rock","color":"#6c6862","size":0.22,"pos":[0,0,0],"yaw":0,"carriedBy":"me","hidden":true},{"id":"the_fire","kind":"fire","label":"the fire","color":"#e8791f","size":1.1,"pos":[2.7,0,12],"yaw":0,"hidden":true},{"id":"man_one","kind":"person","label":"one of the two men","color":"#6b