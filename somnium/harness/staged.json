t":"#3a4060"}}]},{"dur":8,"text":"and I can't see the ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":6,"height":2.2,"angle":155},"actions":[{"actor":"puddle_1","at":0.05,"for":0.25,"appear":true},{"actor":"puddle_2","at":0.08,"for":0.25,"appear":true},{"actor":"puddle_3","at":0.1,"for":0.25,"appear":true},{"actor":"me","move":[0,0,42],"path":"line","yaw":0,"state":"walk"},{"world":{"fogDensity":0.028,"groundColor":"#23262b"}},{"at":0.25,"effect":"blur"}]},{"dur":8,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":130},"actions":[{"actor":"boy","at":0.1,"for":0.25,"appear":true},{"actor":"me","for":0.6,"move":[-0.6,0,44.8],"path":"line","state":"walk"},{"actor":"me","at":0.6,"yaw":59,"state":"idle"},{"actor":"boy","at":0.1,"yaw":190,"state":"idle"},{"world":{"fogDensity":0.018}}]},{"dur":8,"text":"He says he has seen me before and remembers especially the big lens on my camera.","camera":{"mode":"follow","target":"boy","distance":5,"height":1.6,"angle":330},"actions":[{"actor":"boy","at":0.05,"yaw":-121.26,"state":"wave","say":"I've seen you before. I remember especially the big lens on your camera."},{"actor":"big_lens","at":0.3,"size":0.45},{"actor":"me","yaw":59,"state":"pockets"}]},{"dur":6,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"follow","target":"boy","distance":4,"height":1.5,"angle":330},"actions":[{"actor":"boy","at":0.05,"yaw":-121.26,"state":"idle","say":"I'll bet you are not bothered by poor light."},{"actor":"me","yaw":59,"state":"idle"},{"world":{"horizonColor":"#3a3a52","ambient":"#46496c"}},{"at":0.15,"effect":"pulse"}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"follow","target":"someone","distance":7,"height":3,"angle":40},"actions":[{"actor":"someone","at":0.08,"for":0.25,"appear":true},{"actor":"someo