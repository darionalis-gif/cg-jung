t":"me","distance":7,"height":2.5,"angle":60},"actions":[{"actor":"medic","at":0.1,"for":0.25,"appear":true},{"actor":"medic","at":0.1,"for":0.35,"move":[-7.6,0,11],"path":"line","yaw":90,"state":"walk"},{"actor":"medic","at":0.45,"yaw":90,"state":"wave","say":"Timmy D. will go home."},{"actor":"timmy","at":0.12,"for":0.25,"appear":true},{"actor":"timmy","yaw":180,"state":"limp"},{"actor":"me","yaw":270,"state":"idle"}]},{"dur":9,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"fixed","target":"timmy","pos":[-20,3,12],"lookAt":"timmy"},"actions":[{"actor":"me","for":0.45,"move":[-13,0,11],"path":"line","yaw":0,"state":"walk"},{"actor":"me","at":0.45,"yaw":0,"state":"idle"},{"actor":"timmy","at":0.5,"yaw":180,"state":"grieve","say":"I have been denied sick call."},{"actor":"medic","yaw":90,"state":"idle"}]},{"dur":8,"text":"He has seen no one.","camera":{"mode":"wide","target":"timmy","distance":16,"height":5,"angle":60},"actions":[{"actor":"staff","at":0.15,"for":0.25,"vanish":true},{"actor":"medic","at":0.2,"for":0.25,"vanish":true},{"actor":"timmy","yaw":200,"state":"pockets"},{"actor":"me","yaw":20,"state":"grieve"},{"world":{"skyColor":"#a8b6c8","fogDensity":0.024,"ambient":"#5e6a82","sunIntensity":0.5}}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"Warm party chatter curdling into helpless shame as the face comes apart.","world":{"sky":"night","skyColor":"#141a2e","horizonColor":"#2a2438","fogColor":"#2b2534","fogDensity":0.007,"ground":"floor","groundColor":"#6a5646","ambient":"#5c5468","sunColor":"#ffd9a8","sunIntensity":0.9,"sunDir":[0.3,0.8,-0.4],"weather":"none","stars":true},"actors":[{"id":"party_hall","kind":"room","label":"the party","color":"#7a6552","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":20,"depth":18,"height":4,"second":"#8f7c66"}},{"id":"tea_table","kind":"table","label":"the extremely long tea table","color":"#c9b18a","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":12,"depth":1