{"alta-263":{"title":"The Man in the Raincoat","mood":"Being singled out by a stranger's rage for no reason at all, in front of quiet witnesses.","world":{"sky":"overcast","skyColor":"#8a91a0","horizonColor":"#a6aab2","fogColor":"#9aa0a8","fogDensity":0.012,"ground":"stone","groundColor":"#6d6e72","ambient":"#4a5068","sunColor":"#cfd3dc","sunIntensity":0.8,"sunDir":[-0.4,0.8,-0.3],"weather":"none","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#4e5f7a","size":1,"pos":[0,0,-4],"yaw":0,"detail":{"wear":"jacket","wearColor":"#3f4c63","skin":"#c99b76","hair":"#3a2c24"}},{"id":"loud_man","kind":"person","label":"the loud man in the raincoat","color":"#43483f","size":1.05,"pos":[0.6,0,14],"yaw":180,"hidden":true,"detail":{"wear":"raincoat","wearColor":"#3e4a35","skin":"#c08d6a","hair":"#2b2622"}},{"id":"the_street","kind":"road","label":"the street","color":"#55565a","size":1,"pos":[0,0,8],"yaw":0,"detail":{"width":8,"depth":120}},{"id":"the_corner","kind":"road","label":"the corner","color":"#55565a","size":1,"pos":[0,0,22],"yaw":90,"detail":{"width":8,"depth":60}},{"id":"shop_baker","kind":"shop","label":"a shop","color":"#a09484","size":1,"pos":[-10,0,-6],"yaw":90,"detail":{"text":"BAKERY","second":"#7d5f45"}},{"id":"shop_corner","kind":"shop","label":"a shop","color":"#94a0a4","size":1,"pos":[-10,0,6],"yaw":90,"detail":{"text":"GROCER","second":"#5f6f74"}},{"id":"shop_hardware","kind":"shop","label":"a shop","color":"#a89078","size":1,"pos":[10,0,0],"yaw":270,"detail":{"text":"HARDWARE","second":"#6b533c"}},{"id":"house_north","kind":"house","label":"","color":"#9a9288","size":1,"pos":[-10,0,18],"yaw":90,"detail":{"second":"#6a4b3c"}},{"id":"house_east","kind":"house","label":"","color":"#8f8b84","size":1,"pos":[10,0,12],"yaw":270,"detail":{"second":"#69483a"}},{"id":"lamp_a","kind":"lamp","label":"street lamps","color":"#3c3f44","size":1,"pos":[-5,0,-2],"yaw":90,"detail":{"height":4}},{"id":"lamp_b","kind":"lamp","label":"","color":"#3c3f44","size":1,"pos":[5,0,6],"yaw":270,"detail":{"height":4}},{"id":"lamp_c","kind":"lamp","label":"","color":"#3c3f44","size":1,"pos":[-5,0,14],"yaw":90,"detail":{"height":4}},{"id":"lamp_d","kind":"lamp","label":"","color":"#3c3f44","size":1,"pos":[5,0,22],"yaw":270,"detail":{"height":4}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#6d6a74","size":1,"pos":[-6,0,4],"yaw":90,"hidden":true,"detail":{"count":6,"radius":2}},{"id":"onlookers","kind":"crowd","label":"","color":"#726d6a","size":1,"pos":[6.5,0,9],"yaw":270,"hidden":true,"detail":{"count":4,"radius":1.6}}],"beats":[{"dur":7,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":28,"height":9,"angle":200},"actions":[{"actor":"me","yaw":0,"state":"idle"}]},{"dur":6,"text":"There are shops, etc., and street lamps.","camera":{"mode":"fixed","target":"shop_corner","pos":[7,4,-2],"lookAt":"shop_corner"},"actions":[{"actor":"me","state":"idle"}]},{"dur":10,"text":"I'm walking down the street, about to turn a corner,","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":195},"actions":[{"actor":"me","move":[0,0,10],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"and I'm confronted by a loud man in a raincoat - he's really mad about something but I don't know what.","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":200},"actions":[{"actor":"loud_man","at":0.1,"for":0.25,"yaw":180,"state":"yell","appear":true},{"actor":"me","yaw":0,"state":"idle"},{"actor":"loud_man","at":0.3,"move":[0.7,0,12.6],"path":"line"},{"effect":"pulse","at":0.12}]},{"dur":10,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder - he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"loud_man","distance":6,"height":2.4,"angle":30},"actions":[{"actor":"loud_man","for":0.45,"yaw":180,"state":"yell"},{"actor":"loud_man","at":0.45,"state":"pockets"},{"actor":"loud_man","at":0.5,"for":0.3,"move":[0.5,0,11.4],"path":"line"},{"actor":"me","yaw":0,"state":"idle"},{"effect":"quake","at":0.55}]},{"dur":9,"text":"I retreat up the street a bit - there are some people out watching.","camera":{"mode":"follow","target":"me","distance":10,"height":3.2,"angle":275},"actions":[{"actor":"me","move":[0,0,3],"path":"line","yaw":0,"state":"walk"},{"actor":"watchers","at":0.12,"for":0.25,"yaw":90,"state":"idle","appear":true},{"actor":"onlookers","at":0.15,"for":0.25,"yaw":270,"state":"idle","appear":true},{"actor":"loud_man","yaw":180,"state":"pockets"}]},{"dur":7,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"fixed","target":"watchers","pos":[5,3.5,11],"lookAt":"watchers"},"actions":[{"actor":"watchers","yaw":90,"state":"idle"},{"actor":"onlookers","yaw":270,"state":"idle"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"fogDensity":0.016,"ambient":"#474b60"}}]},{"dur":10,"text":"He follows and keeps yelling at me - some of the time he yells around in general but it's mostly at me","camera":{"mode":"follow","target":"me","distance":8.5,"height":3,"angle":250},"actions":[{"actor":"loud_man","move":[1.2,0,5.5],"path":"line","yaw":180,"state":"yell"},{"actor":"loud_man","at":0.4,"for":0.2,"yaw":250},{"actor":"loud_man","at":0.65,"yaw":180},{"actor":"me","move":[0,0,1.5],"path":"line","yaw":0,"state":"walk"}]},{"dur":9,"text":"- I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"orbit","target":"me","distance":9,"height":3.5,"angle":300},"actions":[{"actor":"me","yaw":0,"state":"grieve"},{"actor":"loud_man","yaw":180,"state":"yell"},{"actor":"watchers","yaw":90,"state":"idle"},{"world":{"skyColor":"#7d8494","fogColor":"#8e939c","fogDensity":0.02,"sunIntensity":0.6}}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"Numb, aching solidarity in a white waste where no one listens.","world":{"sky":"overcast","skyColor":"#c6d1dd","horizonColor":"#dde5ed","fogColor":"#d4dce6","fogDensity":0.01,"ground":"snow","groundColor":"#e9eff6","ambient":"#6b7590","sunColor":"#e6edf6","sunIntensity":0.9,"sunDir":[-0.3,0.8,-0.4],"weather":"snow","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#4c5a4a","size":1,"pos":[0,0,-30],"yaw":0,"detail":{"wear":"uniform","wearColor":"#4c5a4a","skin":"#c99a76","hair":"#3a2e26"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#4a5648","size":1,"pos":[-4,0,-32],"yaw":0,"detail":{"count":16,"radius":5,"second":"#3d4a3c"}},{"id":"antarctica","kind":"mountain","label":"Antarctica","color":"#b9c6d4","size":1,"pos":[30,0,150],"yaw":180},{"id":"aid_station","kind":"house","label":"the aid station","color":"#6f7a72","size":1,"pos":[0,0,12],"yaw":180,"detail":{"second":"#4d564f"}},{"id":"sick_call_sign","kind":"sign","label":"","color":"#7a6a52","size":1,"pos":[5,0,7],"yaw":180,"hidden":true,"detail":{"text":"SICK CALL"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#d8dce2","size":1,"pos":[0,0,7],"yaw":180,"hidden":true,"detail":{"count":5,"radius":2,"second":"#b7bfc8"}},{"id":"medic","kind":"person","label":"the kind medic","color":"#5a6a62","size":1,"pos":[6,0,5],"yaw":200,"hidden":true,"detail":{"wear":"uniform","wearColor":"#5a6a62","hair":"#2a2320"}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#556149","size":1,"pos":[-8,0,2],"yaw":90,"hidden":true,"detail":{"wear":"uniform","wearColor":"#556149","skin":"#d3a880","hair":"#7a6034"}}],"beats":[{"dur":10,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"wide","target":"me","distance":30,"height":10,"angle":180},"actions":[{"actor":"me","move":[0,0,-20],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[-4,0,-22],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"orbit","target":"platoon","distance":12,"height":4,"angle":30},"actions":[{"actor":"me","yaw":0,"state":"idle"},{"actor":"platoon","yaw":0,"state":"idle"},{"actor":"sick_call_sign","at":0.1,"for":0.25,"appear":true}]},{"dur":11,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"follow","target":"me","distance":10,"height":3.5,"angle":155},"actions":[{"actor":"me","move":[2,0,-6],"path":"line","yaw":0,"state":"limp"},{"actor":"platoon","move":[-2,0,-7],"path":"line","yaw":0,"state":"limp"},{"actor":"aid_station","color":"#6f7a72"}]},{"dur":9,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"fixed","target":"staff","pos":[17,5,-7],"lookAt":"staff"},"actions":[{"actor":"staff","at":0.1,"for":0.25,"yaw":180,"state":"yell","appear":true},{"actor":"platoon","move":[0,0,4],"path":"line","yaw":0,"state":"limp"},{"actor":"me","move":[3,0,1],"path":"line","yaw":0,"state":"limp"},{"effect":"quake","at":0.6}]},{"dur":9,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"orbit","target":"me","distance":6,"height":3,"angle":25},"actions":[{"actor":"me","yaw":0,"state":"grieve"},{"actor":"platoon","state":"idle"},{"actor":"staff","state":"yell"},{"world":{"skyColor":"#b3bdc9","fogDensity":0.018,"ambient":"#5a6280","sunIntensity":0.6}},{"effect":"pulse","at":0.5}]},{"dur":11,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"orbit","target":"me","distance":8,"height":3,"angle":35},"actions":[{"actor":"medic","at":0.1,"move":[4.5,0,1],"path":"line","yaw":250,"state":"walk","appear":true},{"actor":"medic","at":0.45,"state":"idle","say":"Timmy D. will go home."},{"actor":"me","at":0.4,"yaw":90,"state":"idle"},{"world":{"fogDensity":0.013,"ambient":"#6b7590"}}]},{"dur":10,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"follow","target":"me","distance":7,"height":2.5,"angle":170},"actions":[{"actor":"timmy","at":0.1,"for":0.25,"yaw":90,"state":"idle","appear":true},{"actor":"me","move":[-6.5,0,2],"path":"line","yaw":270,"state":"walk"},{"actor":"medic","yaw":250,"state":"idle"},{"actor":"timmy","at":0.6,"state":"limp","say":"I have been denied sick call."}]},{"dur":9,"text":"He has seen no one.","camera":{"mode":"orbit","target":"timmy","distance":6.5,"height":3,"angle":20},"actions":[{"actor":"timmy","at":0.15,"state":"grieve","say":"I have seen no one."},{"actor":"me","yaw":270,"state":"grieve"},{"actor":"staff","at":0.4,"for":0.25,"vanish":true},{"world":{"skyColor":"#a8b3c1","fogDensity":0.025,"ambient":"#4a5470","sunIntensity":0.5}},{"effect":"blackout","at":0.9}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"A warm crowded party that quietly turns to shame as the body comes apart.","world":{"sky":"night","skyColor":"#141826","horizonColor":"#2a2436","fogColor":"#3b3446","fogDensity":0.006,"ground":"floor","groundColor":"#6b5a48","ambient":"#4c4664","sunColor":"#ffd6a3","sunIntensity":0.9,"sunDir":[0.3,0.9,-0.4],"weather":"none","stars":false},"actors":[{"id":"party_room","kind":"room","label":"the party","color":"#7d6a58","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":26,"depth":16,"height":4,"second":"#c9b08a"}},{"id":"long_table","kind":"table","label":"the extremely long tea table","color":"#c8b596","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":14,"depth":1.2,"second":"#8a6f52"}},{"id":"tea_things","kind":"food","label":"","color":"#efe6d6","size":1,"pos":[-3.2,0.76,0],"yaw":0},{"id":"tea_things_2","kind":"food","label":"","color":"#efe6d6","size":1,"pos":[3.4,0.76,0],"yaw":0},{"id":"table_candle","kind":"candle","label":"","color":"#f6efd8","size":1,"pos":[0,0.76,0],"yaw":0,"glow":true},{"id":"me","kind":"person","label":"me","color":"#6a7fa8","size":1,"pos":[0,0,-8],"yaw":0,"detail":{"skin":"#e8c6a4","hair":"#3a2a20"}},{"id":"young_man","kind":"person","label":"a man about my age (20-25)","color":"#4f6b5c","size":1,"pos":