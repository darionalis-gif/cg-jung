ve_lamp","kind":"lamp","label":"","color":"#6a6a6a","size":1,"pos":[2,0,16],"yaw":0,"hidden":true,"glow":true,"detail":{"height":4}},{"id":"cafe_table","kind":"table","label":"","color":"#7a6444","size":1,"pos":[4.2,0,21],"yaw":0,"hidden":true,"detail":{"width":1.8,"depth":0.9}},{"id":"dishes","kind":"food","label":"the dishes","color":"#e6e2d8","size":1.1,"pos":[4.2,0.78,21],"yaw":0,"hidden":true},{"id":"outside_door","kind":"door","label":"a door, it seemed to lead outside","color":"#8a6f4a","size":1,"pos":[10.5,0,22],"yaw":-90,"hidden":true},{"id":"rifle","kind":"gun","label":"a rifle","color":"#3b3630","size":1,"pos":[3.6,1.2,21.6],"yaw":0,"hidden":true}],"beats":[{"dur":8,"text":"Ann and I were walking thru the slums.","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":160},"actions":[{"actor":"me","move":[0,0,-6],"path":"line","yaw":0,"state":"walk"},{"actor":"ann","move":[-1.7,0,-6],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"I was leery of being robbed. I had money on my person.","camera":{"mode":"orbit","target":"me","distance":5,"height":2.4,"angle":10},"actions":[{"actor":"me","yaw":0,"state":"idle"},{"actor":"ann","yaw":0,"state":"idle"},{"world":{"fogColor":"#8a857e","fogDensity":0.02,"ambient":"#464b5e","sunIntensity":0.7}},{"effect":"pulse","at":0.35}]},{"dur":7,"text":"Then I was with my brother Steve.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":150},"actions":[{"actor":"ann","at":0.05,"for":0.25,"vanish":true},{"actor":"steve","at":0.2,"for":0.25,"appear":true},{"actor":"me","at":0.25,"move":[0,0,3],"path":"line","yaw":0,"state":"walk"},{"actor":"steve","at":0.25,"move":[1.8,0,3],"path":"line","yaw":0,"state":"walk"},{"effect":"blur","at":0.1}]},{"dur":8,"text":"We came to a manhole or some hold in a grating.","camera":{"mode":"follow","target":"me","distance":8,"height":4,"angle":150},"actions":[{"actor":"hold","at":0.05,"for":0.25,"appear":true},{"actor":"grating","at":0.05,"for":0.25,"appear":true},{"actor":"weeds","at":0.05,"for":0.25,"appear":true},{"actor":"me","move":[0.9,0,9.9],"path":"line","yaw":0,"state":"walk"},{"actor":"steve","move":[-0.9,0,9.9],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"We looked thru it and there were two men down there.","camera":{"mode":"orbit","target":"hold","distance":6,"height":11,"angle":0},"actions":[{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":0,"state":"kneel"},{"actor":"man_one","at":0.25,"for":0.25,"state":"idle","appear":true},{"actor":"man_two","at":0.35,"for":0.25,"state":"idle","appear":true}]},{"dur":9,"text":"We wanted to go down there. I yelled down and one man didn't want to move.","camera":{"mode":"orbit","target":"hold","distance":5,"height":9.5,"angle":30},"actions":[{"actor":"me","at":0.15,"for":0.5,"yaw":0,"state":"shake"},{"actor":"man_two","at":0.4,"for":0.3,"move":[-1.1,-4,11.1],"path":"line","state":"walk"},{"actor":"man_one","yaw":180,"state":"idle"},{"actor":"steve","state":"kneel"}]},{"dur":7,"text":"I was going to drop in a rock.","camera":{"mode":"orbit","target":"me","distance":5,"height":3.5,"angle":25},"actions":[{"actor":"the_rock","at":0.15,"for":0.25,"appear":true},{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":0,"state":"kneel"}]},{"dur":9,"text":"There were a lot of weeds on the grating, so we made a fire and burned the weeds.","camera":{"mode":"fixed","target":"the_fire","pos":[7.5,3.8,6.5],"lookAt":"the_fire"},"actions":[{"actor":"the_rock","at":0.05,"for":0.25,"vanish":true},{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":0,"state":"kneel"},{"actor":"the_fire","at":0.25,"for":0.25,"appear":true},{"actor":"the_smoke","at":0.35,"for":0.25,"appear":true},{"actor":"weeds","at":0.35,"state":"shrink","color":"#3a2a18"},{"actor":"weeds","at":0.85,"for":0.25,"vanish":true},{"world":{"ambient":"#5a4a48","sunColor":"#e0b98c"}},{"effect":"flash","at":0.28}]},{"dur":10,"text":"Then we were down in the hold. It was like a cave and there was a cafe there.","camera":{"mode":"fixed","target":"the_cave","pos":[15,7.5,11],"lookAt":"the_cave"},"actions":[{"effect":"blackout"},{"actor":"the_fire","at":0.05,"for":0.25,"vanish":true},{"actor":"the_smoke","at":0.05,"for":0.25,"vanish":true},{"actor":"grating","at":0.05,"for":0.25,"vanish":true},{"actor":"hold","at":0.05,"for":0.25,"vanish":true},{"actor":"man_one","at":0.05,"for":0.25,"vanish":true},{"actor":"man_two","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_road","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_a","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_b","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_c","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_d","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_e","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_shop","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_fence","at":0.05,"for":0.25,"vanish":true},{"actor":"the_cave","at":0.15,"for":0.25,"appear":true},{"actor":"cave_lamp","at":0.15,"for":0.25,"appear":true},{"actor":"the_cafe","at":0.35,"for":0.25,"appear":true},{"actor":"cafe_table","at":0.4,"for":0.25,"appear":true},{"actor":"dishes","at":0.4,"for":0.25,"appear":true},{"actor":"me","at":0.1,"move":[0.6,0,20],"path":"line","yaw":180,"state":"idle"},{"actor":"steve","at":0.1,"move":[2.4,0,20.4],"path":"line","yaw":180,"state":"idle"},{"world":{"sky":"void","skyColor":"#0f1218","horizonColor":"#141a22","fogColor":"#11161d","fogDensity":0.018,"ground":"stone","groundColor":"#4a4a50","ambient":"#3f4666","sunColor":"#c0a377","sunIntensity":0.55,"stars":false}}]},{"dur":7,"text":"I saw a door down there. It seemed to lead outside.","camera":{"mode":"fixed","target":"outside_door","pos":[3.5,3.2,13],"lookAt":"outside_door"},"actions":[{"actor":"outside_door","at":0.15,"for":0.25,"appear":true},{"actor":"me","at":0.25,"move":[6,0,20.5],"path":"line","yaw":90,"state":"walk"},{"actor":"steve","yaw":90,"state":"idle"}]},{"dur":9,"text":"Steve washed the dishes and then went out.","camera":{"mode":"follow","target":"steve","distance":7,"height":3,"angle":120},"actions":[{"actor":"steve","for":0.15,"move":[3.4,0,21.8],"path":"line","yaw":180,"state":"idle"},{"actor":"dishes","at":0.2,"for":0.35,"state":"spin"},{"actor":"steve","at":0.6,"move":[9.2,0,22],"path":"line","yaw":90,"state":"walk"},{"actor":"outside_door","at":0.85,"state":"open"},{"actor":"me","yaw":90,"state":"idle"}]},{"dur":10,"text":"He had a rifle in his hand and we walked bravely.","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":165},"actions":[{"actor":"rifle","at":0.05,"for":0.25,"appear":true},{"actor":"rifle","at":0.15,"move":[16,1.2,22.6],"path":"line","yaw":90,"state":"float"},{"actor":"steve","at":0.15,"move":[16,0,22.6],"path":"line","yaw":90,"state":"walk"},{"actor":"me","at":0.15,"move":[16,0,20.6],"path":"line","yaw":90,"state":"walk"},{"world":{"sky":"dawn","skyColor":"#d8a878","horizonColor":"#f0c79a","fogColor":"#d6b393","fogDensity":0.01,"ambient":"#6b7089","sunColor":"#ffd9a5","sunIntensity":1.2}}]}]},"natural_scientist-203":{"title":"Before Sun-Up","mood":"Hurrying through wet darkness toward a town you cannot yet see, and being recognised on the way.","world":{"sky":"night","skyColor":"#0d1430","horizonColor":"#26304f","fogColor":"#1a2138","fogDensity":0.013,"ground":"stone","groundColor":"#3b3f4a","ambient":"#3f4668","sunColor":"#8fa6d8","sunIntensity":0.5,"sunDir":[0.2,0.5,1],"weather":"none","stars":true},"actors":[{"id":"me","kind":"person","label":"me","color":"#4a5570","size":1,"pos":[0,0,-26],"yaw":0,"detail":{"skin":"#c9a289","hair":"#3a2c22"}},{"id":"lens","kind":"box","label":"the big lens on my camera","color":"#1c1c22","size":0.2,"pos":[0.45,1.15,-25.7],"yaw":0,"detail":{"width":1,"depth":1.6,"height":1,"second":"#8f9bb5"}},{"id":"sidewalk","kind":"path","label":"","color":"#4b4e57","size":1,"pos":[0,0,-12],"yaw":0,"detail":{"width":2.4,"depth":60}},{"id":"sidewalk_far","kind":"p