,"label":"the dishes","color":"#e2e0d6","size":1,"pos":[42,0.75,41],"yaw":0,"hidden":true},{"id":"cave_lamp","kind":"lamp","label":"","color":"#5a5450","size":1,"pos":[38,0,37.5],"yaw":0,"hidden":true,"detail":{"height":4}},{"id":"door_out","kind":"door","label":"a door, it seemed to lead outside","color":"#8a7350","size":1,"pos":[34,0,42],"yaw":90,"hidden":true,"glow":true}],"beats":[{"dur":9,"text":"Ann and I were walking thru the slums.","camera":{"mode":"follow","target":"me","distance":9,"height":3.5,"angle":165},"actions":[{"actor":"me","move":[-1,0,-2],"path":"line","yaw":0,"state":"walk"},{"actor":"ann","move":[1.2,0,-2],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"I was leery of being robbed. I had money on my person.","camera":{"mode":"orbit","target":"me","distance":6,"height":2.6,"angle":20},"actions":[{"actor":"me","yaw":10,"state":"pockets"},{"actor":"ann","yaw":350,"state":"idle"},{"world":{"fogColor":"#5d4c4c","fogDensity":0.017,"ambient":"#464a64","sunIntensity":0.75}}]},{"dur":6,"text":"Then I was with my brother Steve.","camera":{"mode":"follow","target":"me","distance":7,"height":2.8,"angle":40},"actions":[{"effect":"pulse","at":0.05},{"actor":"ann","at":0.1,"for":0.25,"vanish":true},{"actor":"steve","at":0.15,"for":0.25,"yaw":20,"state":"idle","appear":true},{"actor":"me","yaw":340,"state":"idle"}]},{"dur":8,"text":"We came to a manhole or some hold in a grating.","camera":{"mode":"orbit","target":"manhole","distance":10,"height":7,"angle":160},"actions":[{"actor":"me","move":[-6,0,3.9],"path":"line","yaw":0,"state":"walk"},{"actor":"steve","move":[-8,0,5.4],"path":"line","yaw":40,"state":"walk"}]},{"dur":8,"text":"We looked thru it and there were two men down there.","camera":{"mode":"orbit","target":"manhole","distance":9,"height":7,"angle":160},"actions":[{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":55,"state":"kneel"},{"actor":"man_one","at":0.12,"for":0.25,"state":"idle","appear":true},{"actor":"man_two","at":0.12,"move":[-7,-4,6.6],"path":"line","state":"walk","appear":true},{"actor":"me","for":0.2,"move":[-5.1802,0,2.7209],"path":"line"},{"actor":"steve","for":0.2,"move":[-4.6044,0,2.9216],"path":"line"}]},{"dur":9,"text":"We wanted to go down there. I yelled down and one man didn't want to move.","camera":{"mode":"orbit","target":"manhole","distance":8,"height":6.5,"angle":160},"actions":[{"actor":"me","yaw":0,"state":"yell"},{"actor":"steve","yaw":50,"state":"kneel"},{"actor":"man_one","yaw":200,"state":"pockets"},{"actor":"man_two","yaw":170,"state":"idle"},{"actor":"me","for":0.2,"move":[-5.1802,0,2.7209],"path":"line"},{"actor":"steve","for":0.2,"move":[-4.6044,0,2.9216],"path":"line"}]},{"dur":6,"text":"I was going to drop in a rock.","camera":{"mode":"orbit","target":"me","distance":6,"height":4,"angle":160},"actions":[{"actor":"rock","at":0.1,"for":0.25,"appear":true},{"actor":"me","yaw":0,"state":"kneel"},{"actor":"man_one","state":"pockets"},{"actor":"me","for":0.2,"move":[-5.1802,0,2.7209],"path":"line"}]},{"dur":10,"text":"There were a lot of weeds on the grating, so we made a fire and burned the weeds.","camera":{"mode":"orbit","target":"manhole","distance":9,"height":6.5,"angle":160},"actions":[{"actor":"weeds","at":0.05,"for":0.25,"appear":true},{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":50,"state":"kneel"},{"actor":"fire","at":0.35,"for":0.25,"appear":true},{"actor":"weeds","at":0.7,"for":0.25,"vanish":true},{"world":{"fogColor":"#6a4f42","ambient":"#5a4c52","sunColor":"#ff9d5c"}},{"effect":"flash","at":0.35}]},{"dur":10,"text":"Then we were down in the hold. It was like a cave and there was a cafe there.","camera":{"mode":"follow","target":"me","distance":9,"height":3.2,"angle":200},"actions":[{"effect":"blackout"},{"actor":"grating","at":0.05,"for":0.25,"vanish":true},{"actor":"manhole","at":0.05,"for":0.25,"vanish":true},{"actor":"fire","at":0.05,"for":0.25,"vanish":true},{"actor":"man_one","at":0.05,"for":0.25,"vanish":true},{"actor":"man_two","at":0.05,"for":0.25,"vanish":true},{"actor":"rock","at":0.05,"for":0.25,"vanish":true},{"actor":"road","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_a","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_b","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_c","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_d","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_e","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_shop","at":0.05,"for":0.25,"vanish":true},{"actor":"me","at":0.05,"for":0.3,"move":[40,0,40],"path":"line","yaw":30,"state":"idle"},{"actor":"steve","at":0.05,"for":0.3,"move":[42,0,40.4],"path":"line","yaw":30,"state":"idle"},{"actor":"cave","at":0.12,"for":0.25,"appear":true},{"actor":"cave_lamp","at":0.12,"for":0.25,"appear":true},{"actor":"cafe","at":0.15,"for":0.25,"appear":true},{"actor":"cafe_table","at":0.15,"for":0.25,"appear":true},{"actor":"dishes","at":0.15,"for":0.25,"appear":true},{"world":{"sky":"void","skyColor":"#14161f","horizonColor":"#1b1e29","fogColor":"#1c1f2a","fogDensity":0.02,"ground":"stone","groundColor":"#4d4841","ambient":"#4b5170","sunColor":"#ffd6a0","sunIntensity":0.5,"weather":"none","stars":false}}]},{"dur":7,"text":"I saw a door down there. It seemed to lead outside.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":175},"actions":[{"actor":"door_out","at":0.1,"for":0.25,"appear":true},{"actor":"me","move":[37.5,0,41.5],"path":"line","yaw":270,"state":"walk"},{"actor":"steve","yaw":280,"state":"idle"}]},{"dur":9,"text":"Steve washed the dishes and then went out.","camera":{"mode":"follow","target":"steve","distance":7,"height":2.6,"angle":35},"actions":[{"actor":"steve","for":0.5,"move":[42,0,40.1],"path":"line","yaw":0,"state":"idle"},{"actor":"steve","at":0.55,"move":[35.8,0,42],"path":"line","yaw":270,"state":"walk"},{"actor":"door_out","at":0.85,"state":"open"},{"actor":"me","yaw":270,"state":"idle"}]},{"dur":9,"text":"He had a rifle in his hand and we walked bravely.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":150},"actions":[{"actor":"rifle","at":0.1,"for":0.25,"appear":true},{"actor":"steve","move":[32.5,0,42.8],"path":"line","yaw":270,"state":"walk"},{"actor":"me","move":[32.5,0,41.2],"path":"line","yaw":270,"state":"walk"},{"world":{"fogColor":"#2a3040","fogDensity":0.016,"ambient":"#5a6288","sunIntensity":0.7}}]}]},"natural_scientist-203":{"title":"Hurrying to the Suburb Before Sun-Up","mood":"A dark, hurried walk toward a town, softened by a boy who already knows me.","world":{"sky":"night","skyColor":"#0b1024","horizonColor":"#1c2440","fogColor":"#141a2e","fogDensity":0.02,"ground":"soil","groundColor":"#2b2b33","ambient":"#3b4266","sunColor":"#9fb0d8","sunIntensity":0.6,"sunDir":[0.2,0.6,-0.5],"weather":"none","stars":true},"actors":[{"id":"me","kind":"person","label":"me","color":"#4a5a78","size":1,"pos":[0,0,-40],"yaw":0,"detail":{"wear":"coat","wearColor":"#33405c","skin":"#c9a68a","hair":"#3a3028"}},{"id":"lens","kind":"box","label":"the big lens on my camera","color":"#20242c","size":0.2,"pos":[0,0,-40],"yaw":0,"carriedBy":"me","detail":{"second":"#7f95b8"}},{"id":"path","kind":"path","label":"the path or sidewalk","color":"#54545c","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":2.4,"depth":90}},{"id":"puddle_1","kind":"water","label":"","color":"#2c3a55","size":0.1,"pos":[0.6,0,-24],"yaw":0},{"id":"puddle_2","kind":"water","label":"a puddle of water","color":"#2c3a55","size":0.1,"pos":[-0.6,0,-16],"yaw":0},{"id":"puddle_3","kind":"water","label":"","color":"#2c3a55","size":0.1,"pos":[0.5,0,-11],"yaw":0},{"id":"puddle_4","kind":"water","label":"","color":"#2c3a55","size":0.1,"pos":[-0.4,0,-4],"yaw":0},{"id":"boy","kind":"person","label":"a boy, 8 or 10 years old","color":"#8a6d4b","size":0.7,"pos":[1.3,0,4.4],"yaw":200,"hidden":true,"detail":{"wear":"jacket","wearColor":"#6d4f33","skin":"#d6b394","hair":"#4a3524"}},{"id":"someone","kind":"person","label":"someone","color":"#5c5568","size":1,"pos":[2.6,0,13],"yaw":205,"hidden":true,"detail":{"wear":"raincoat","wearColor":"#3d4450","skin":"#8a6244","hair":"#241d18"}},{"id":"moon","kind":"moon","label":"","color":"#dfe6f5","size":1.2,"pos":[16,10.3511,78],"yaw":0,"glow":true},{"id":"town_house","kind":"house","label":"the town, a suburb of London","color":"#6b6257","size":1,"pos":[-12,0,24],"yaw":90,"detail":{"second":"#3c3229"}},{"id":"house_2","kind":"house","label":"","color":"#655c52","size":1,"pos":[12,0,27],"yaw":270,"detail":{"second":"#3c3229"}},{"id":"house_3","kind":"house","label":"","color":"#5f584f","size":1,"pos":[-13,0,39],"yaw":90,"detail":{"second":"#38302a"}},{"id":"house_4","kind":"house","label":"","color":"#6a6156","size":1,"pos":[13,0,42],"yaw":270,"detail":{"second":"#38302a"}},{"id":"house_5","kind":"house","label":"","color":"#5c554c","size":1,"pos":[-12,0,54],"yaw":90,"detail":{"second":"#38302a"}},{"id":"lamp_1","kind":"lamp","label":"","color":"#3a3a42","size":1,"pos":[3,0,18],"yaw":0,"detail":{"height":4}},{"id":"lamp_2","kind":"lamp","label":"","color":"#3a3a42","size":1,"pos":[3,0,32],"yaw":0,"detail":{"height":4}},{"id":"fence","kind":"fence","label":"","color":"#4b4038","size":1,"pos":[-4.5,0,8],"yaw":0,"detail":{"width":10}}],"beats":[{"dur":9,"text":"I am walking or trotting along a path or sidewalk, hurrying to reach a certain town which is a suburb of London.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":175},"actions":[{"actor":"me","move":[0,0,-28],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"It is still dark (I wish to reach my destination by sun-up)","camera":{"mode":"follow","target":"me","distance":10,"height":4,"angle":168},"actions":[{"actor":"me","move":[0,0,-20],"path":"line","yaw":0,"state":"walk"},{"world":{"fogDensity":0.024,"ambient":"#3a4060"}}]},{"dur":9,"text":"and I can't see the ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":6,"height":2,"angle":155},"actions":[{"actor":"me","move":[-0.6,0,-9],"path":"arc","yaw":0,"state":"walk"},{"effect":"blur","at":0.3}]},{"dur":8,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"follow","target":"me","distance":7,"height":2.4,"angle":95},"actions":[{"actor":"boy","at":0.1,"for":0.25,"state":"idle","appear":true},{"actor":"me","for":0.6,"move":[0.2,0,2.4],"path":"line","yaw":15,"state":"walk"},{"actor":"me","at":0.65,"state":"idle"},{"actor":"boy","at":0.7,"state":"wave"},{"world":{"fogDensity":0.02}}]},{"dur":9,"text":"He says he has seen me before and remembers especially the big lens on my camera.","camera":{"mode":"orbit","target":"me","distance":5,"height":2,"angle":60},"actions":[{"actor":"boy","yaw":200,"state":"idle","say":"he has seen me before, and remembers especially the big lens on my camera"},{"actor":"me","yaw":15,"state":"idle"}]},{"dur":7,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"follow","target":"boy","distance":5,"height":1.7,"angle":35},"actions":[{"actor":"boy","state":"idle","say":"I'll bet you are not bothered by poor light."},{"actor":"me","state":"pockets"}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"wide","target":"me","distance":18,"height":7,"angle":172},"actions":[{"actor":"someone","at":0.1,"for":0.25,"state":"idle","appear":true},{"actor":"me","for":0.55,"move":[0.4,0,12],"path":"line","yaw":0,"state":"walk"},{"actor":"me","at":0.6,"state":"idle"},{"actor":"someone","at":0.6,"state":"wave","say":"you have now reached the town"},{"world":{"horizonColor":"#2a3050","ambient":"#454b70","sunIntensity":0.75}}]}]}}