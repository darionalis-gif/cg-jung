},{"actor":"raincoat_man","at":0.7,"state":"shake"},{"actor":"me","for":0.55,"move":[0,0,-1.2],"path":"line","yaw":0,"state":"walk"},{"actor":"me","at":0.6,"state":"idle"},{"effect":"pulse","at":0.15}]},{"dur":8,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder - he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"raincoat_man","distance":6,"height":2.6,"angle":160},"actions":[{"actor":"raincoat_man","yaw":180,"state":"shake"},{"actor":"raincoat_man","at":0.35,"for":0.25,"move":[0.6,0,0.4],"path":"line"},{"actor":"me","yaw":180,"state":"idle"},{"actor":"me","at":0.4,"for":0.3,"move":[-0.3,0,-2.1],"path":"line"},{"effect":"quake","at":0.42}]},{"dur":8,"text":"I retreat up the street a bit - there are some people out watching.","camera":{"mode":"wide","target":"me","distance":18,"height":7,"angle":300},"actions":[{"actor":"me","move":[-0.6,0,-10],"path":"line","yaw":180,"state":"walk"},{"actor":"watchers","at":0.35,"for":0.25,"appear":true},{"actor":"watchers","at":0.35,"yaw":90,"state":"idle"},{"actor":"raincoat_man","yaw":180,"state":"shake"},{"world":{"fogDensity":0.016}}]},{"dur":6,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"fixed","target":"me","pos":[8,3.5,-14.5],"lookAt":[-7.5,1.6,-9]},"actions":[{"actor":"watchers","yaw":90,"state":"idle"},{"actor":"me","yaw":180,"state":"idle"},{"actor":"raincoat_man","state":"shake"},{"world":{"skyColor":"#454a63","ambient":"#3f4460"}}]},{"dur":9,"text":"He follows and keeps yelling at me - some of the time he yells around in general but it's mostly at me -","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":0},"actions":[{"actor":"raincoat_man","move":[0.8,0,-7],"path":"line","yaw":180,"state":"walk"},{"actor":"raincoat_man","at":0.45,"for":0.25,"yaw":250,"state":"shake"},{"actor":"raincoat_man","at":0.72,"yaw":180,"state":"shake"},{"actor":"me","move":[-0.8,0,-13],"path":"line","yaw":180,"state":"walk"},{"actor":"watchers","state":"idle"}]},{"dur":8,"text":"I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"orbit","target":"me","distance":8,"height":4,"angle":160},"actions":[{"actor":"me","yaw":180,"state":"idle"},{"actor":"raincoat_man","move":[0.5,0,-9.5],"path":"line","yaw":180,"state":"shake"},{"actor":"watchers","state":"idle"},{"world":{"fogColor":"#565667","fogDensity":0.02,"sunIntensity":0.5}},{"effect":"pulse","at":0.8}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"Cold, exhausted grief: everyone is lame, no one is heard.","world":{"sky":"overcast","skyColor":"#b9c6d4","horizonColor":"#dbe4ec","fogColor":"#cdd8e2","fogDensity":0.012,"ground":"snow","groundColor":"#e6edf4","ambient":"#6d7a92","sunColor":"#eaf0f8","sunIntensity":0.9,"sunDir":[-0.4,0.5,-0.7],"weather":"snow","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#5d6448","size":1,"pos":[2,0,-22],"yaw":0,"detail":{"second":"#4a5140","skin":"#d8b090","hair":"#3a2f26"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#5a6146","size":1,"pos":[-3,0,-24],"yaw":0,"detail":{"count":22,"radius":5,"second":"#454b38"}},{"id":"mountains","kind":"mountain","label":"Antarctica","color":"#c3cedb","size":1,"pos":[-60,0,190],"yaw":0},{"id":"mountains_east","kind":"mountain","label":"","color":"#b9c5d3","size":0.8,"pos":[150,0,60],"yaw":200},{"id":"snowfield","kind":"field","label":"","color":"#e8eff6","size":1,"pos":[0,0,10],"yaw":0,"detail":{"count":24,"radius":55}},{"id":"aid_station","kind":"house","label":"the aid station","color":"#7d8a7a","size":1,"pos":[0,0,26],"yaw":180,"detail":{"second":"#4d5a52"}},{"id":"aid_sign","kind":"sign","label":"","color":"#8b9490","size":1,"pos":[-5,0,21],"yaw":180,"detail":{"text":"SICK CALL"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#dfe6ea","size":1,"pos":[4,0,20],"yaw":180,"hidden":true,"detail":{"count":5,"radius":2,"se