{"alta-263":{"title":"The Man in the Raincoat","mood":"A stranger's rage arrives out of nowhere on a quiet street, and there is no reason in it and nowhere to put it.","world":{"sky":"dusk","skyColor":"#4b5170","horizonColor":"#c08a5f","fogColor":"#5b5f74","fogDensity":0.012,"ground":"stone","groundColor":"#55565e","ambient":"#4a5070","sunColor":"#e6a26e","sunIntensity":0.8,"sunDir":[-0.4,0.45,-0.8],"weather":"none","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#7d8ba6","size":1,"pos":[0,0,-22],"yaw":0,"detail":{"skin":"#d8ab8c","hair":"#3a2c22"}},{"id":"the_street","kind":"road","label":"","color":"#3f4046","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":8,"depth":120}},{"id":"the_corner_street","kind":"road","label":"the corner","color":"#3f4046","size":1,"pos":[0,0,16],"yaw":90,"detail":{"width":8,"depth":90}},{"id":"shop_bakery","kind":"shop","label":"a shop","color":"#8d7f6e","size":1,"pos":[-11,0,-4],"yaw":90,"detail":{"text":"BAKERY","second":"#c9b487"}},{"id":"shop_grocer","kind":"shop","label":"a shop","color":"#77706a","size":1,"pos":[-11,0,8],"yaw":90,"detail":{"text":"GROCER","second":"#b9c4a2"}},{"id":"shop_corner","kind":"shop","label":"the shop on the corner","color":"#846f63","size":1,"pos":[11,0,10],"yaw":-90,"detail":{"text":"NEWS","second":"#d3b98f"}},{"id":"house_east","kind":"house","label":"","color":"#6e6a66","size":1,"pos":[11,0,-4],"yaw":-90,"detail":{"second":"#4a3f39"}},{"id":"house_west","kind":"house","label":"","color":"#6a655f","size":1,"pos":[-11,0,-18],"yaw":90,"detail":{"second":"#4a3f39"}},{"id":"house_east_far","kind":"house","label":"","color":"#726b64","size":1,"pos":[11,0,-20],"yaw":-90,"detail":{"second":"#463c36"}},{"id":"lamp_a","kind":"lamp","label":"a street lamp","color":"#4c4f56","size":1,"pos":[5,0,-16],"yaw":0,"glow":true,"detail":{"height":4.5}},{"id":"lamp_b","kind":"lamp","label":"a street lamp","color":"#4c4f56","size":1,"pos":[-5,0,-4],"yaw":0,"glow":true,"detail":{"height":4.5}},{"id":"lamp_c","kind":"lamp","label":"a street lamp","color":"#4c4f56","size":1,"pos":[5,0,6],"yaw":0,"glow":true,"detail":{"height":4.5}},{"id":"lamp_d","kind":"lamp","label":"a street lamp","color":"#4c4f56","size":1,"pos":[-5,0,16],"yaw":0,"glow":true,"detail":{"height":4.5}},{"id":"loud_man","kind":"person","label":"a loud man in a raincoat","color":"#3d4a40","size":1.05,"pos":[2,0,13],"yaw":180,"hidden":true,"detail":{"second":"#2b3630","skin":"#c9977a","hair":"#33302c"}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#6d7183","size":1,"pos":[7,0,-5],"yaw":180,"hidden":true,"detail":{"count":6,"radius":2.5}},{"id":"watchers_two","kind":"crowd","label":"more people watching","color":"#71707e","size":1,"pos":[-7,0,2],"yaw":90,"hidden":true,"detail":{"count":4,"radius":1.8}},{"id":"the_moon","kind":"moon","label":"","color":"#e7e6d8","size":1,"pos":[1.0953573965284053e-14,24,-89.44271909999158],"yaw":0,"glow":true}],"beats":[{"dur":7,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":22,"height":8,"angle":150},"actions":[{"actor":"me","yaw":0,"state":"idle"}]},{"dur":7,"text":"There are shops, etc., and street lamps.","camera":{"mode":"fixed","target":"me","pos":[16,6,-30],"lookAt":[0,2,-2]},"actions":[{"actor":"me","move":[0,0,-16],"path":"line","yaw":0,"state":"walk"}]},{"dur":9,"text":"I'm walking down the street, about to turn a corner, and I'm confronted by a loud man in a raincoat -","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":170},"actions":[{"actor":"me","move":[0,0,8],"path":"line","yaw":0,"state":"walk"},{"actor":"loud_man","at":0.55,"for":0.25,"yaw":180,"state":"idle","appear":true},{"effect":"pulse","at":0.55}]},{"dur":8,"text":"he's really mad about something but I don't know what.","camera":{"mode":"orbit","target":"loud_man","distance":5,"height":2.5,"angle":20},"actions":[{"actor":"loud_man","yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"skyColor":"#3f4463","fogColor":"#4e5268","fogDensity":0.016,"ambient":"#454a68","sunIntensity":0.6}}]},{"dur":9,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder -","camera":{"mode":"follow","target":"me","distance":6,"height":2.5,"angle":60},"actions":[{"actor":"loud_man","move":[1.2,0,10.2],"path":"line","state":"shake"},{"actor":"me","at":0.45,"move":[-0.4,0,7.4],"path":"line","state":"shake"},{"effect":"quake","at":0.5}]},{"dur":6,"text":"he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"loud_man","distance":4,"height":2,"angle":30},"actions":[{"actor":"loud_man","yaw":180,"state":"idle"}]},{"dur":8,"text":"I retreat up the street a bit -","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":0},"actions":[{"actor":"me","move":[0,0,0],"path":"line","yaw":0,"state":"walk"},{"actor":"loud_man","yaw":180,"state":"shake"}]},{"dur":7,"text":"there are some people out watching.","camera":{"mode":"fixed","target":"watchers","pos":[-6.5,4,-12],"lookAt":"watchers"},"actions":[{"actor":"watchers","for":0.25,"yaw":180,"state":"idle","appear":true},{"actor":"watchers_two","at":0.2,"for":0.25,"yaw":90,"state":"idle","appear":true},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":7,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":45},"actions":[{"actor":"watchers","state":"idle"},{"actor":"watchers_two","state":"idle"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"horizonColor":"#a3714f","fogDensity":0.018}}]},{"dur":9,"text":"He follows and keeps yelling at me -","camera":{"mode":"follow","target":"me","distance":10,"height":3,"angle":0},"actions":[{"actor":"me","move":[0,0,-6],"path":"line","yaw":0,"state":"walk"},{"actor":"loud_man","move":[1,0,-1],"path":"line","yaw":180,"state":"walk"},{"actor":"loud_man","at":0.6,"state":"shake"}]},{"dur":8,"text":"some of the time he yells around in general but it's mostly at me -","camera":{"mode":"orbit","target":"loud_man","distance":7,"height":3,"angle":60},"actions":[{"actor":"loud_man","for":0.4,"yaw":90,"state":"shake"},{"actor":"loud_man","at":0.5,"yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":11,"text":"I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"wide","target":"me","distance":20,"height":9,"angle":120},"actions":[{"actor":"loud_man","yaw":180,"state":"shake"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"sky":"night","skyColor":"#2b3050","horizonColor":"#6b5a58","fogColor":"#44485e","fogDensity":0.02,"ambient":"#3e4468","sunIntensity":0.45,"stars":true}}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"Frozen, aching solidarity turning into the cold loneliness of not being believed.","world":{"sky":"overcast","skyColor":"#b9c6d6","horizonColor":"#dbe4ee","fogColor":"#c9d5e2","fogDensity":0.012,"ground":"snow","groundColor":"#e6eef6","ambient":"#6a7690","sunColor":"#eaf1ff","sunIntensity":1.1,"sunDir":[-0.4,0.7,-0.5],"weather":"none","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#5c6650","size":1,"pos":[0,0,0],"yaw":0,"detail":{"second":"#3f4738","skin":"#d8b08c","hair":"#3a2f28"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#5c6650","size":1,"pos":[5,0,1],"yaw":0,"detail":{"count":20,"radius":5,"second":"#39412f"}},{"id":"mountains","kind":"mountain","label":"Antarctica","color":"#c4d2e0","size":1,"pos":[-40,0,190],"yaw":0},{"id":"mountains_east","kind":"mountain","label":"","color":"#bccbdb","size":0.8,"pos":[110,0,165],"yaw":30},{"id":"snow_field","kind":"field","label":"","color":"#e9f1f8","size":1,"pos":[0,0,15],"yaw":0,"detail":{"count":20,"radius":55}},{"id":"aid_station","kind":"house","label":"the aid station","color":"#8a9aa6","size":1,"pos":[0,0,31],"yaw":180,"detail":{"second":"#5f6d78"}},{"id":"sick_call_sign","kind":"sign","label":"sick call","color":"#7d8a94","size":1,"pos":[-5,0,24],"yaw":200,"hidden":true,"detail":{"text":"SICK CALL"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#e3e8ec","size":1,"pos":[0,0,25],"yaw":180,"hidden":true,"detail":{"count":5,"radius":2,"second":"#9fb0bb"}},{"id":"medic","kind":"person","label":"a kind, middle-aged black medic","color":"#dfe6ea","size":1.02,"pos":[-4,0,21],"yaw":170,"hidden":true,"detail":{"second":"#9aa7ae","skin":"#4a3227","hair":"#2a2320"}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#5c6650","size":0.96,"pos":[6,0,19],"yaw":200,"hidden":true,"detail":{"second":"#3f4738","skin":"#e0bda0","hair":"#8a6a3c"}}],"beats":[{"dur":8,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"wide","target":"me","distance":26,"height":9,"angle":140},"actions":[{"actor":"me","move":[0,0,5],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[5,0,6],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":40},"actions":[{"actor":"sick_call_sign","at":0.1,"for":0.25,"appear":true},{"actor":"me","yaw":20,"state":"idle"},{"actor":"platoon","state":"idle"},{"actor":"platoon","at":0.5,"for":0.4,"state":"shake"}]},{"dur":11,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"follow","target":"me","distance":10,"height":3.5,"angle":90},"actions":[{"actor":"me","move":[-1.5,0,21],"path":"line","yaw":0,"state":"limp"},{"actor":"platoon","move":[5,0,22],"path":"line","yaw":0,"state":"limp"},{"world":{"fogDensity":0.016,"ambient":"#616d86","sunIntensity":0.9,"weather":"snow"}}]},{"dur":9,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"fixed","target":"aid_station","pos":[-17,6,11],"lookAt":"aid_station"},"actions":[{"actor":"staff","at":0.05,"for":0.25,"appear":true},{"actor":"platoon","move":[3,0,24.5],"path":"line","state":"push"},{"actor":"staff","at":0.35,"state":"shake"},{"actor":"me","state":"idle"},{"effect":"pulse","at":0.4}]},{"dur":9,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"orbit","target":"me","distance":5,"height":2.2,"angle":20},"actions":[{"actor":"me","at":0.3,"state":"kneel"},{"world":{"skyColor":"#9dabbd","horizonColor":"#c3cedb","fogColor":"#b3c0cf","fogDensity":0.022,"groundColor":"#d8e2ec","ambient":"#4c5570","sunIntensity":0.7}},{"effect":"blur","at":0.55}]},{"dur":11,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"follow","target":"me","distance":6.5,"height":2.6,"angle":60},"actions":[{"actor":"medic","at":0.05,"for":0.25,"appear":true},{"actor":"me","at":0.1,"yaw":250,"state":"idle"},{"actor":"medic","at":0.05,"for":0.3,"move":[-3,0,20.5],"path":"line","yaw":70,"state":"walk"},{"actor":"medic","at":0.4,"state":"idle"},{"actor":"medic","at":0.45,"say":"Timmy D. will go home."},{"actor":"timmy","at":0.6,"for":0.25,"appear":true},{"actor":"timmy","state":"idle"},{"world":{"fogDensity":0.018,"ambient":"#5c6580","sunIntensity":0.9}}]},{"dur":10,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":70},"actions":[{"actor":"me","for":0.45,"move":[4.5,0,19.5],"path":"line","yaw":80,"state":"limp"},{"actor":"me","at":0.5,"state":"idle"},{"actor":"timmy","yaw":260,"state":"idle"},{"actor":"timmy","at":0.55,"say":"I have been denied sick call."}]},{"dur":9,"text":"He has seen no one.","camera":{"mode":"orbit","target":"timmy","distance":9,"height":4,"angle":30},"actions":[{"actor":"staff","at":0.15,"for":0.25,"vanish":true},{"actor":"medic","at":0.2,"for":0.25,"vanish":true},{"actor":"platoon","at":0.25,"for":0.25,"vanish":true},{"actor":"timmy","state":"idle"},{"actor":"me","state":"idle"},{"world":{"skyColor":"#93a1b4","fogColor":"#aab8c8","fogDensity":0.026,"ambient":"#454e6a","sunIntensity":0.5,"weather":"snow"}},{"effect":"blackout","at":0.9}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"warm party chatter souring into helpless, private horror as the body comes apart mid-sentence","world":{"sky":"dusk","skyColor":"#3b3550","horizonColor":"#6b5a58","fogColor":"#4a4250","fogDensity":0.012,"ground":"floor","groundColor":"#6b5843","ambient":"#5a5468","sunColor":"#ffd9a8","sunIntensity":1.2,"sunDir":[-0.3,0.85,-0.4],"weather":"none","stars":false},"actors":[{"id":"party_room","kind":"room","label":"","color":"#7a6a5c","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":36,"depth":15,"height":4.5,"second":"#8f7a63"}},{"id":"tea_table","kind":"table","label":"an extremely long tea table","color":"#e8e0d0","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":30,"depth":1.6,"second":"#8b6f4e"}},{"id":"me","kind":"person","label":"me","color":"#4b5f8a","size":1,"pos":[0,0,3],"yaw":180,"detail":{"skin":"#e0b48f","hair":"#3a2a22"}},{"id":"guests_near","kind":"crowd","label":"many people","color":"#8a6d84","size":1,"pos":[-7,0,2.8],"yaw":180,"detail":{"count":12,"radius":4.5}},{"id":"guests_far","kind":"crowd","label":"many people","color":"#6d7f8a","size":1,"pos":[-5,0,-2.8],"yaw":0,"detail":{"count":14,"radius":5}},{"id":"guests_end","kind":"crowd","label":"many people crowded around the table","color":"#7c6a5a","size":1,"pos":[9,0,-0.2],"yaw":90,"detail":{"count":10,"radius":4}},{"id":"young_man","kind":"person","label":"a man about my age, 20-25","color":"#3f6b52","size":1,"pos":[2.1,0,3.6],"yaw":200,"detail":{"skin":"#d9a97f","hair":"#26201c"}},{"id":"young_woman","kind":"person","label":"a woman about my age, 20-25","color":"#a34f5c","size":1,"pos":[-2,0,3.5],"yaw":160,"detail":{"skin":"#eec4a2","hair":"#7a4a2a"}},{"id":"tooth_1","kind":"tooth","label":"my tooth","color":"#f4efe2","size":2.6,"pos":[0.15,1.55,3.15],"yaw":0,"hidden":tru