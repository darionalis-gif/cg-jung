"cafe_table","kind":"table","label":"","color":"#7b5f43","size":1,"pos":[-4.4,0,9.6],"yaw":20,"hidden":true,"detail":{"width":2.2,"depth":1}},{"id":"cafe_chair","kind":"chair","label":"","color":"#6a5138","size":1,"pos":[-3.2,0,8.8],"yaw":200,"hidden":true},{"id":"dishes","kind":"food","label":"the dishes","color":"#e6e2d6","size":1,"pos":[-4.4,0.8,9.6],"yaw":0,"hidden":true},{"id":"cave_lamp","kind":"lamp","label":"","color":"#8d8a80","size":1,"pos":[3.4,0,9.5],"yaw":0,"hidden":true,"glow":true,"detail":{"height":3.4}},{"id":"door","kind":"door","label":"a door, it seemed to lead outside","color":"#8f6f4a","size":1,"pos":[7,0,12],"yaw":90,"hidden":true,"glow":true},{"id":"rifle","kind":"gun","label":"a rifle in his hand","color":"#4a423a","size":1,"pos":[6.6,0,11.8],"yaw":80,"hidden":true}],"beats":[{"dur":8,"text":"Ann and I were walking thru the slums.","camera":{"mode":"follow","target":"me","distance":9,"height":3.2,"angle":160},"actions":[{"actor":"me","move":[0,0,-8],"path":"line","yaw":0,"state":"walk"},{"actor":"ann","move":[1.6,0,-8],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"I was leery of being robbed. I had money on my person.","camera":{"mode":"follow","target":"me","distance":5.5,"height":2.2,"angle":25},"actions":[{"actor":"me","move":[0,0,-3.4],"path":"line","yaw":0,"state":"walk"},{"actor":"ann","move":[1.6,0,-3.2],"path":"line","yaw":0,"state":"walk"},{"world":{"skyColor":"#70747a","fogColor":"#85817a","fogDensity":0.018,"ambient":"#3f4460","sunIntensity":0.7}},{"effect":"pulse","at":0.55}]},{"dur":6,"text":"Then I was with my brother Steve.","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":55},"actions":[{"actor":"ann","at":0.1,"for":0.25,"vanish":true},{"actor":"steve","at":0.25,"for":0.25,"yaw":0,"state":"idle","appear":true},{"actor":"me","yaw":20,"state":"idle"},{"effect":"blur","at":0.1}]},{"dur":7,"text":"We came to a manhole or some hold in a grating.","camera":{"mode":"follow","target":"me","distance":8,"height":4,"angle":165},"actions":[{"actor":"manhole","at":0.05,"for":0.25,"appear":true},{"actor":"weeds","at":0.05,"for":0.25,"appear":true},{"actor":"me","move":[-0.6,0,2],"path":"line","yaw":0,"state":"walk"},{"actor":"steve","move":[1.9,0,2.2],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"We looked thru it and there were two men down there.","camera":{"mode":"orbit","target":"manhole","distance":5.5,"height":9.5,"angle":30},"actions":[{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":340,"state":"kneel"},{"actor":"man_one","at":0.35,"for":0.25,"state":"idle","appear":true},{"actor":"man_two","at":0.45,"for":0.25,"state":"idle","appear":true}]},{"dur":8,"text":"We wanted to go down there. I yelled down and one man didn't want to move.","camera":{"mode":"orbit","target":"manhole","distance":5,"height":8.5,"angle":80},"actions":[{"actor":"me","at":0.25,"for":0.5,"state":"shake"},{"actor":"man_two","at":0.5,"move":[1.2,-4,5.2],"path":"arc","state":"walk"},{"actor":"man_one","yaw":20,"state":"idle"}]},{"dur":6,"text":"I was going to drop in a rock.","camera":{"mode":"follow","target":"me","distance":5,"height":3,"angle":40},"actions":[{"actor":"rock","at":0.15,"for":0.25,"appear":true},{"actor":"me","yaw":0,"state":"kneel"}]},{"dur":10,"text":"There were a lot of weeds on the grating, so we made a fire and burned the weeds.","camera":{"mode":"fixed","target":"manhole","pos":[7,3.5,9],"lookAt":"manhole"},"actions":[{"actor":"rock","at":0.05,"for":0.25,"vanish":true},{"actor":"me","yaw":0,"state":"kneel"},{"actor":"steve","yaw":340,"state":"kneel"},{"actor":"fire","at":0.35,"for":0.25,"state":"grow","appear":true},{"actor":"weeds","at":0.5,"state":"shrink"},{"actor":"weeds","at":0.85,"for":0.25,"vanish":true},{"world":{"fogColor":"#8f7f70","ambient":"#4d4356","sunColor":"#e0b184"}},{"effect":"pulse","at":0.4}]},{"dur":9,"text":"Then we were down in the hold. It was like a cave and there was a cafe there.","camera":{"mode":"wide","target":"me","distance":16,"height":6,"angle":200},"actions":[{"effect":"blackout"},{"actor":"slum_house_a","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_b","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_c","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_d","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_house_e","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_shop","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_fence","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_path","at":0.05,"for":0.25,"vanish":true},{"actor":"fire","at":0.05,"for":0.25,"vanish":true},{"actor":"manhole","at":0.05,"for":0.25,"vanish":true},{"actor":"cave","at":0.15,"for":0.25,"appear":true},{"actor":"cave_lamp","at":0.15,"for":0.25,"appear":true},{"actor":"cafe","at":0.35,"for":0.25,"appear":true},{"actor":"cafe_table","at":0.35,"for":0.25,"appear":true},{"actor":"cafe_chair","at":0.35,"for":0.25,"appear":true},{"actor":"dishes","at":0.4,"for":0.25,"appear":true},{"actor":"me","at":0.05,"move":[0,0,6],"path":"line","yaw":0,"state":"idle"},{"actor":"steve","at":0.05,"move":[1.9,0,6.4],"path":"line","yaw":0,"state":"idle"},{"actor":"man_one","at":0.05,"move":[-2.6,0,11],"path":"line","yaw":120,"state":"idle"},{"actor":"man_two","at":0.05,"move":[-1.2,0,12.4],"path":"line","yaw":160,"state":"sit"},{"world":{"sky":"void","skyColor":"#151824","horizonColor":"#1d2130","fogColor":"#191c26","fogDensity":0.02,"ground":"stone","groundColor":"#4a4740","ambient":"#3a4060","sunColor":"#d9b48a","sunIntensity":0.5,"stars":false}}]},{"dur":7,"text":"I saw a door down there. It seemed to lead outside.","camera":{"mode":"follow","target":"me","distance":7,"height":3,"angle":175},"actions":[{"actor":"door","at":0.2,"for":0.25,"appear":true},{"actor":"me","yaw":49,"state":"idle"},{"actor":"steve","move":[-3.2,0,8.6],"path":"line","yaw":200,"state":"walk"},{"world":{"ambient":"#414a6a","sunIntensity":0.6}}]},{"dur":9,"text":"Steve washed the dishes and then went out.","camera":{"mode":"follow","target":"steve","distance":8,"height":3.2,"angle":135},"actions":[{"actor":"dishes","for":0.45,"state":"shake"},{"actor":"steve","for":0.45,"state":"idle"},{"actor":"steve","at":0.45,"move":[6.6,0,11.8],"path":"arc","yaw":80,"state":"walk"},{"actor":"door","at":0.8,"state":"open"},{"actor":"me","yaw":49,"state":"idle"}]},{"dur":10,"text":"He had a rifle in his hand and we walked bravely.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":170},"actions":[{"actor":"rifle","at":0.05,"for":0.25,"appear":true},{"actor":"rifle","at":0.15,"move":[12.6,0,15],"path":"line","yaw":80},{"actor":"steve","at":0.15,"move":[12.6,0,15],"path":"line","yaw":80,"state":"walk"},{"actor":"me","at":0.15,"move":[11,0,13.4],"path":"arc","yaw":80,"state":"walk"},{"actor":"cave","at":0.75,"for":0.25,"vanish":true},{"world":{"sky":"dusk","skyColor":"#4a5a78","horizonColor":"#d09a6a","fogColor":"#7a808c","fogDensity":0.01,"ground":"soil","groundColor":"#6b5f52","ambient":"#55607f","sunColor":"#e8bb8c","sunIntensity":1.1}}]}]},"natural_scientist-203":{"title":"Before Sun-Up","mood":"A dark, hurried walk toward a town, interrupted by a small stranger who already knows my eye for poor light.","world":{"sky":"night","skyColor":"#0d1330","horizonColor":"#1c2444","fogColor":"#161d33","fogDensity":0.02,"ground":"soil","groundColor":"#26262c","ambient":"#3f4668","sunColor":"#8ea0c8","sunIntensity":0.5,"sunDir":[-0.35,0.45,0.82],"weather":"none","stars":true},"actors":[{"id":"me","kind":"person","label":"me, with my camera","color":"#4a5a72","size":1,"pos":[0,0,-26],"yaw":0,"detail":{"skin":"#c79a75","hair":"#3a2e26"}},{"id":"the_path","kind":"path","label":"","color":"#3b3b40","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":2.4,"depth":70}},{"id":"the_path_far","kind":"path","label":"","color":"#3b3b40","size":1,"pos":[0,0,62],"yaw":0,"detail":{"width":2.4,"depth":54}},{"id":"town_sign","kind":"sign","label":"the town, a suburb of London","color":"#6a6f7d","size":1,"