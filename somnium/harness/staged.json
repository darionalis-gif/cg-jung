nd":"#d8b06a"}},{"id":"cafe_table","kind":"table","label":"","color":"#6b4f36","size":1,"pos":[4.3,0,7],"yaw":20,"hidden":true,"detail":{"width":1.8,"depth":0.9}},{"id":"dishes","kind":"food","label":"the dishes","color":"#e8e4da","size":1,"pos":[4.3,0,7],"yaw":0,"hidden":true},{"id":"cave_lamp","kind":"lamp","label":"","color":"#c8b48a","size":0.9,"pos":[2.6,0,12.5],"yaw":0,"hidden":true,"glow":true,"detail":{"height":3.2}},{"id":"cave_fire","kind":"fire","label":"","color":"#ff9440","size":0.9,"pos":[-2.6,0,12],"yaw":0,"hidden":true,"glow":true},{"id":"door","kind":"door","label":"a door — it seemed to lead outside","color":"#8a6b45","size":1,"pos":[-6,0,10],"yaw":90,"hidden":true},{"id":"rifle","kind":"gun","label":"a rifle in his hand","color":"#4a3b2c","size":1,"pos":[1.8,0,8],"yaw":0,"hidden":true}],"beats":[{"dur":8,"text":"Ann and I were walking thru the slums.","camera":{"mode":"follow","target":"me","distance":9,"height":3.2,"angle":195},"actions":[{"actor":"me","move":[-1.2,0,-14],"path":"line","yaw":0,"state":"walk"},{"actor":"ann","move":[1.2,0,-14],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"I was leery of being robbed. I had money on my person.","camera":{"mode":"orbit","target":"me","distance":5,"height":2.4,"angle":160},"actions":[{"actor":"me","move":[-1.2,0,-9],"path":"line","yaw":35,"state":"walk"},{"actor":"ann","move":[1.4,0,-9],"path":"line","yaw":0,"state":"walk"},{"world":{"fogColor":"#6a5a50","fogDensity":0.019,"ambient":"#453f52","sunIntensity":0.85}},{"effect":"pulse","at":0.55}]},{"dur":6,"text":"Then I was with my brother Steve.","camera":{"mode":"follow","target":"me","distance":7,"height":2.8,"angle":150},"actions":[{"actor":"ann","at":0.1,"for":0.25,"vanish":true},{"actor":"steve","at":0.25,"for":0.25,"yaw":0,"state":"idle","appear":true},{"actor":"me","yaw":60,"state":"idle"},{"effect":"blur","at":0.1}]},{"dur":7,"text":"We came to a manhole or some hold in a grating.","camera":{"mode":"follow","target":"me","distance":