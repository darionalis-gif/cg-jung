"},{"world":{"fogColor":"#6b6157","fogDensity":0.018,"ambient":"#43434f","sunIntensity":0.7}},{"effect":"pulse","at":0.6}]},{"dur":6,"text":"Then I was with my brother Steve.","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":60},"actions":[{"actor":"ann","at":0.1,"for":0.25,"vanish":true},{"actor":"steve","at":0.25,"for":0.25,"state":"idle","appear":true},{"actor":"me","yaw":45,"state":"idle"},{"effect":"blur","at":0.05}]},{"dur":10,"text":"We came to a manhole or some hold in a grating. We looked thru it and there were two men down there.","camera":{"mode":"orbit","target":"hold","distance":7,"height":11,"angle":200},"actions":[{"actor":"hold","at":0.05,"for":0.25,"appear":true},{"actor":"grating","at":0.05,"for":0.25,"appear":true},{"actor":"weeds","at":0.05,"for":0.25,"appear":true},{"actor":"man_still","at":0.5,"for":0.25,"state":"idle","appear":true},{"actor":"man_other","at":0.55,"for":0.25,"state":"idle","appear":true},{"actor":"me","for":0.7,"move":[-1.4,0,17.9],"path":"line","yaw":0,"state":"walk"},{"actor":"steve","for":0.7,"move":[1.3,0,17.9],"path":"line","yaw":0,"state":"walk"},{"actor":"me","at":0.75,"state":"kneel"},{"actor":"steve","at":0.8,"state":"kneel"}]},{"dur":8,"text":"We wanted to go down there. I yelled down and one man didn't want to move.","camera":{"mode":"orbit","target":"hold","distance":6,"height":10,"angle":260},"actions":[{"actor":"me","at":0.1,"state":"shake"},{"actor":"man_still","yaw":160,"state":"idle"},{"actor":"man_other","at":0.4,"move":[1.3,-4,19.9],"path":"line","state":"walk"},{"actor":"steve","state":"kneel"}]},{"dur":6,"text":"I was going to drop in a rock.","camera":{"mode":"orbit","target":"me","distance":4.5,"height":6,"angle":40},"actions":[{"actor":"rock","at":0.1,"for":0.25,"appear":true},{"actor":"me","state":"kneel"},{"actor":"man_still","state":"idle"}]},{"dur":9,"text":"There were a lot of weeds on the grating, so we made a fire and burned the weeds.","camera":{"mode":"orbit","target":"fire","distance":8,"height":5,"angle":220},"actions":[{"actor":"fire","at":0.25,"for":0.25,"appear":true},{"actor":"weeds","at":0.3,"color":"#8a5a20"},{"actor":"weeds","at":0.65,"for":0.25,"vanish":true},{"actor":"me","state":"kneel"},{"actor":"steve","state":"kneel"},{"world":{"skyColor":"#5c5148","fogColor":"#6b5a48","ambient":"#584434","sunColor":"#e8b982","weather":"sparks"}},{"effect":"flash","at":0.25}]},{"dur":10,"text":"Then we were down in the hold. It was like a cave and there was a cafe there.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":140},"actions":[{"effect":"blackout"},{"actor":"grating","at":0.05,"for":0.25,"vanish":true},{"actor":"hold","at":0.05,"for":0.25,"vanish":true},{"actor":"fire","at":0.05,"for":0.25,"vanish":true},{"actor":"road","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_h1","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_h2","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_h3","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_h4","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_h5","at":0.05,"for":0.25,"vanish":true},{"actor":"slum_shop","at":0.05,"for":0.25,"vanish":true},{"actor":"cave","at":0.2,"for":0.25,"appear":true},{"actor":"cafe","at":0.35,"for":0.25,"appear":true},{"actor":"cafe_table","at":0.35,"for":0.25,"appear":true},{"actor":"cafe_chair","at":0.35,"for":0.25,"appear":true},{"actor":"candle","at":0.35,"for":0.25,"appear":true},{"actor":"hold_lamp","at":0.2,"for":0.25,"appear":true},{"actor":"me","at":0.2,"move":[-0.6,0,20.5],"path":"line","yaw":250,"state":"walk"},{"actor":"steve","at":0.2,"move":[1.2,0,20.5],"path":"line","yaw":250,"state":"walk"},{"actor":"man_still","at":0.1,"move":[3.2,0,22.5],"path":"line","state":"idle"},{"actor":"man_other","at":0.1,"move":[4.4,0,23.4],"path":"line","state":"idle"},{"world":{"sky":"void","skyColor":"#101018","horizonColor":"#15151d","fogColor":"#15151d","fogDensity":0.02,"ground":"stone","groundColor":"#4a453d","ambient":"#3a4060","sunColor":"#c0a887","sunIntensity":0.5,"weather":"none","stars":false}}]},{"dur":7,"text":"I saw a door down there. It seemed to lead outside.","camera":{"mode":"fixed","target":"door_out","pos":[-2.5,2.6,14.5],"lookAt":"door_out"},"actions":[{"actor":"door_out","at":0.1,"for":0.25,"appear":true},{"actor":"me","yaw":90,"state":"idle"},{"actor":"steve","yaw":90,"state":"idle"},{"world":{"ambient":"#48506e","sunIntensity":0.6}}]},{"dur":10,"text":"Steve washed the dishes and then went out.","camera":{"mode":"follow","target":"steve","distance":6.5,"height":2.6,"angle":40},"actions":[{"actor":"dishes","at":0.05,"for":0.25,"appear":true},{"actor":"steve","at":0.05,"for":0.15,"move":[-2.6,0,18.2],"path":"line","yaw":340,"state":"walk"},{"actor":"steve","at":0.2,"for":0.35,"state":"push"},{"actor":"steve","at":0.6,"move":[5.2,0,21.8],"path":"line","yaw":90,"state":"walk"},{"actor":"door_out","at":0.85,"state":"open"},{"actor":"dishes","at":0.5,"color":"#f2efe6"},{"actor":"me","yaw":90,"state":"idle"}]},{"dur":10,"text":"He had a rifle in his hand and we walked bravely.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":180},"actions":[{"actor":"rifle","at":0.05,"for":0.25,"appear":true},{"actor":"cave","at":0.35,"for":0.25,"vanish":true},{"actor":"cafe","at":0.35,"for":0.25,"vanish":true},{"actor":"cafe_table","at":0.35,"for":0.25,"vanish":true},{"actor":"cafe_chair","at":0.35,"for":0.25,"vanish":true},{"actor":"candle","at":0.35,"for":0.25,"vanish":true},{"actor":"dishes","at":0.3,"for":0.25,"vanish":true},{"actor":"hold_lamp","at":0.4,"for":0.25,"vanish":true},{"actor":"door_out","at":0.5,"for":0.25,"vanish":true},{"actor":"me","move":[10,0,23],"path":"line","yaw":90,"state":"walk"},{"actor":"steve","move":[11.6,0,23.6],"path":"line","yaw":90,"state":"walk"},{"world":{"sky":"dawn","skyColor":"#8fa6c4","horizonColor":"#e0b07a","fogColor":"#c9b498","fogDensity":0.008,"ground":"soil","groundColor":"#8a7659","ambient":"#6a6f82","sunColor":"#ffd9a8","sunIntensi