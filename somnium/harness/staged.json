","color":"#413c38","size":1,"pos":[12.5,0,41],"yaw":270},{"id":"lamp_near","kind":"lamp","label":"","color":"#2a2e38","size":1,"pos":[2.2,0,18],"yaw":0,"detail":{"height":4}},{"id":"lamp_far","kind":"lamp","label":"","color":"#2a2e38","size":1,"pos":[-2.2,0,32],"yaw":0,"detail":{"height":4}},{"id":"the_moon","kind":"moon","label":"","color":"#cfd8ee","size":1.4,"pos":[11,9.468606022007675,72],"yaw":0,"glow":true}],"beats":[{"dur":9,"text":"I am walking or trotting along a path or sidewalk, hurrying to reach a certain town which is a suburb of London.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":165},"actions":[{"actor":"me","move":[0,0,-22],"path":"line","yaw":0,"state":"run"}]},{"dur":8,"text":"It is still dark (I wish to reach my destination by sun-up)","camera":{"mode":"wide","target":"me","distance":20,"height":8,"angle":155},"actions":[{"actor":"me","move":[0,0,-16],"path":"line","yaw":0,"state":"walk"},{"world":{"skyColor":"#0b1120","horizonColor":"#2b3a5c","ambient":"#3a4060"}}]},{"dur":9,"text":"and I can't see the ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":5,"height":2,"angle":150},"actions":[{"actor":"me","move":[0.4,0,-3.5],"path":"line","yaw":0,"state":"walk"},{"world":{"fogColor":"#161c2e","fogDensity":0.026}},{"effect":"blur","at":0.45}]},{"dur":8,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"follow","target":"me","distance":7,"height":2.5,"angle":120},"actions":[{"actor":"the_boy","at":0.1,"for":0.25,"appear":true},{"actor":"me","for":0.6,"move":[0,0,0.6],"path":"line","yaw":10,"state":"walk"},{"actor":"me","at":0.65,"state":"idle"},{"actor":"the_boy","yaw":190,"state":"idle"},{"world":{"fogDensity":0.02}}]},{"dur":9,"text":"He says he has seen me before and remembers especially the big lens on my camera.","camera":{"mode":"fixed","target":"me","pos":[5.2,1.6,-0.4],"lookAt":"me"},"actions":[{"actor":"the_boy","at":0.05,"state":"wave","say":"I have seen you before — I remember the big lens on your camera."},{"actor":"big_lens","at":0.3,"size":0.45},{"actor":"me","state":"idle"}]},{"dur":8,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"fixed","target":"the_boy","pos":[5.6,1.5,5.4],"lookAt":"the_boy"},"actions":[{"actor":"the_boy","at":0.05,"state":"idle","say":"I'll bet you are not bothered by poor light."},{"actor":"me","state":"pockets"},{"effect":"pulse","at":0.6}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"follow","target":"me","distance":9,"height":3.5,"angle":145},"actions":[{"actor":"someone","at":0.1,"for":0.25,"appear":true},{"actor":"someone","for":0.4,"move":[-2.4,0,5.2],"path":"line","yaw":170,"state":"walk"},{"actor":"someone","at":0.45,"state":"idle","say":"You have now reached the town."},{"actor":"me","for":0.4,"move":[0,0,4],"path":"line","yaw":350,"state":"walk"},{"actor":"the_boy","state":"idle"},{"world":{"horizonColor":"#4a5470","fogDensity":0.014,"ambient":"#454b70","sunIntensity":0.7}}]}]}}