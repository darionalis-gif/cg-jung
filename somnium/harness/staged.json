p","label":"","color":"#4a4d52","size":1,"pos":[-5,0,8],"yaw":90,"detail":{"height":4.5}},{"id":"lamp_4","kind":"lamp","label":"","color":"#4a4d52","size":1,"pos":[5,0,18],"yaw":270,"detail":{"height":4.5}},{"id":"loud_man","kind":"person","label":"the loud man in the raincoat","color":"#5a3f33","size":1.15,"pos":[2.9969,0,20.4175],"yaw":180,"hidden":true,"detail":{"wear":"raincoat","wearColor":"#6d5a2f","skin":"#c08f6b","hair":"#2e2622"}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#6f7480","size":1,"pos":[-7.5,0,-6],"yaw":45,"hidden":true,"detail":{"count":3,"radius":2.5}}],"beats":[{"dur":7,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":22,"height":8,"angle":200},"actions":[{"actor":"me","yaw":0,"state":"idle"},{"actor":"street","state":"idle"}]},{"dur":6,"text":"There are shops, etc., and street lamps.","camera":{"mode":"orbit","target":"me","distance":14,"height":4,"angle":40},"actions":[{"actor":"shop_bakery","state":"idle"},{"actor":"shop_grocer","state":"idle"},{"actor":"lamp_1","state":"idle"},{"actor":"lamp_2","state":"idle"},{"actor":"me","state":"idle"}]},{"dur":8,"text":"I'm walking down the street, about to turn a corner,","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":165},"actions":[{"actor":"me","move":[0,0,3],"path":"line","yaw":0,"state":"walk"},{"actor":"corner_street","state":"idle"}]},{"dur":8,"text":"and I'm confronted by a loud man in a raincoat - he's really mad about something but I don't know what.","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":120},"actions":[{"actor":"loud_man","at":0.1,"for":0.6,"move":[1.1987,0,15.967],"state":"walk","appear":true},{"actor":"loud_man","at":0.15,"move":[0.8,0,15],"path":"line","yaw":180,"state":"walk"},{"actor":"me","for":0.5,"move":[0,0,13],"path":"line","yaw":0,"state":"walk"},{"actor":"me","at":0.6,"state":"idle"},{"at":0.15,"effect":"pulse"}]},{"dur":9,"text":"He just stands and yells at me,","camera":{"mode":"follow","target":"me","distance":7,"height":2.5,"angle":100},"actions":[{"actor":"loud_man","yaw":180,"state":"yell"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"fogDensity":0.016,"ambient":"#565a6a"}}]},{"dur":8,"text":"sometimes shoving with his elbow and shoulder - he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"me","distance":6,"height":2.4,"angle":70},"actions":[{"actor":"loud_man","for":0.45,"move":[0.4,0,13.9],"path":"line","yaw":180,"state":"push"},{"actor":"loud_man","at":0.5,"state":"pockets"},{"actor":"me","state":"shake"},{"at":0.2,"effect":"quake"}]},{"dur":8,"text":"I retreat up the street a bit -","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":30},"actions":[{"actor":"me","move":[-1,0,4],"path":"line","yaw":180,"state":"walk"},{"actor":"loud_man","yaw":180,"state":"pockets"}]},{"dur":7,"text":"there are some people out watching.","camera":{"mode":"follow","target":"me","distance":9,"height":3.2,"angle":20},"actions":[{"actor":"watchers","at":0.1,"for":0.25,"appear":true},{"actor":"watchers","yaw":20,"state":"idle"},{"actor":"me","move":[-1,0,0],"path":"line","yaw":180,"state":"walk"}]},{"dur":7,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"orbit","target":"watchers","distance":8,"height":3,"angle":0},"actions":[{"actor":"watchers","yaw":20,"state":"idle"},{"actor":"me","yaw":200,"state":"idle"},{"world":{"fogColor":"#9ea0a6","ambient":"#525a6c"}}]},{"dur":9,"text":"He follows and keeps yelling at me -","camera":{"mode":"follow","target":"me","distance":8,"height":2.8,"angle":140},"actions":[{"actor":"loud_man","for":0.6,"move":[0.6,0,2.5],"path":"line","yaw":180,"state":"walk"},{"actor":"loud_man","at":0.6,"state":"yell"},{"actor":"me","move":[-1.4,0,-3],"path":"line","yaw":180,"state":"walk"}]},{"dur":8,"text":"some of the time he yells around in general but it's mostly at me -","camera":{"mode":"orbit","target":"loud_man","distance":7,"height":2.6,"angle":0},"actions":[{"actor":"loud_man","for":0.4,"yaw":270,"state":"yell"},{"actor":"loud_man","at":0.45,"yaw":185,"state":"yell"},{"actor":"me","yaw":10,"state":"idle"},{"actor":"watchers","yaw":40,"state":"idle"}]},{"dur":10,"text":"I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"orbit","target":"me","distance":6,"height":2.4,"angle":0},"actions":[{"actor":"me","yaw":180,"state":"idle"},{"actor":"loud_man","yaw":180,"state":"yell"},{"actor":"watchers","yaw":40,"state":"idle"},{"world":{"skyColor":"#7b8290","fogDensity":0.02,"ambient":"#4c5468","sunIntensity":0.55}},{"at":0.7,"effect":"blur"}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"The cold ache of being lame, unheard and passed over by everyone who could help.","world":{"sky":"overcast","skyColor":"#b7c5d6","horizonColor":"#d6dfe9","fogColor":"#cbd7e3","fogDensity":0.008,"ground":"snow","groundColor":"#eaf0f7","ambient":"#6b7791","sunColor":"#e2eaf6","sunIntensity":0.9,"sunDir":[0.3,0.6,-0.4],"weather":"snow","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#a9aca5","size":1,"pos":[-1.6349,0,-0.8174],"yaw":0,"detail":{"wear":"coat","wearColor":"#a9aca5","skin":"#d9b48f","hair":"#3a2c1e"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#4a5140","size":1,"pos":[4,0,2],"yaw":0,"detail":{"count":16,"radius":4.5}},{"id":"antarctica","kind":"mountain","label":"Antarctica","color":"#c9d6e4","size":1,"pos":[-15,0,150],"yaw":180},{"id":"aid_station","kind":"house","label":"the aid station","color":"#8d9aa8","size":1,"pos":[8,0,32],"yaw":180},{"id":"sick_call_sign","kind":"sign","label":"","color":"#6c7684","size":1,"pos":[4,0,28],"yaw":180,"hidden":true,"detail":{"text":"SICK CALL"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#dfe4ea","size":1,"pos":[8,0,27],"yaw":180,"hidden":true,"detail":{"count":4,"radius":2}},{"id":"medic","kind":"person","label":"the kind middle-aged black medic","color":"#3f4a3a","size":1.02,"pos":[-5,0,18],"yaw":45,"hidden":true,"detail":{"wear":"uniform","wearColor":"#3f4a3a","skin":"#4a3226","hair":"#241a14"}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#8a6a42","size":1,"pos":[-6.7844,0,25.2394],"yaw":270,"hidden":true,"detail":{"wear":"jacket","wearColor":"#8a6a42","skin":"#e2bd98","hair":"#c2a15c"}}],"beats":[{"dur":9,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"wide","target":"me","distance":24,"height":8,"angle":180},"actions":[{"actor":"me","move":[0,0,8],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[4,0,10],"path":"line","yaw":0,"state":"walk"},{"actor":"antarctica","state":"idle"}]},{"dur":7,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":150},"actions":[{"actor":"sick_call_sign","at":0.1,"for":0.25,"appear":true},{"actor":"me","yaw":10,"state":"idle"},{"actor":"platoon","yaw":0,"state":"idle"},{"actor":"aid_station","state":"idle"}]},{"dur":11,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"follow","target":"platoon","distance":12,"height":3.5,"angle":160},"actions":[{"actor":"platoon","move":[3,0,22],"path":"line","yaw":0,"state":"limp"},{"actor":"me","move":[0,0,21],"path":"line","yaw":0,"state":"limp"},{"actor":"aid_station","state":"idle"},{"world":{"fogDensity":0.011,"sunIntensity":0.75}}]},{"dur":9,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"orbit","target":"staff","distance":10,"height":3.5,"angle":200},"actions":[{"actor":"staff","at":0.05,"for":0.25,"yaw":180,"state":"yell","appear":true},{"actor":"platoon","move":[5.5,0,24.5],"path":"line","yaw":20,"state":"push"},{"actor":"me","yaw":30,"state":"idle"},{"at":0.25,"effect":"pulse"}]},{"dur":9,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"orbit","target":"me","distance":5,"height":2,"angle":0},"actions":[{"actor":"me","yaw":0,"state":"grieve"},{"actor":"platoon","yaw":20,"state":"idle"},{"world":{"fogColor":"#b6c2d1","fogDensity":0.016,"ambient":"#4b5470","sunIntensity":0.6}},{"at":0.5,"effect":"blur"}]},{"dur":11,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"follow","target":"me","distance":6.5,"height":2.4,"angle":70},"actions":[{"actor":"medic","at":0.05,"for":0.4,"move":[-1.6,0,20.6],"path":"line","yaw":80,"state":"walk","appear":true},{"actor":"medic","at":0.45,"yaw":75.96,"state":"idle","say":"Timmy D. will go home. His bad feet should have kept him out of the Army."},{"actor":"me","yaw":280,"state":"idle"},{"actor":"timmy","at":0.15,"for":0.6,"move":[-2.7138,0,22.6957],"yaw":270,"state":"walk","appear":true},{"world":{"fogDensity":0.012,"ambient":"#5c6884","sunIntensity":0.75}}]},{"dur":9,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"follow","target":"timmy","distance":7,"height":2.2,"angle":65},"actions":[{"actor":"me","for":0.5,"move":[10.3,0,25.7],"path":"line","yaw":90,"state":"walk"},{"actor":"me","at":0.5,"state":"idle"},{"actor":"timmy","at":0.55,"yaw":270,"state":"limp","say":"I have been denied sick call."},{"actor":"medic","at":0.2,"for":0.25,"yaw":-27.99,"vanish":true}]},{"dur":8,"text":"He has seen no one.","camera":{"mode":"orbit","target":"timmy","distance":5.5,"height":2,"angle":70},"actions":[{"actor":"timmy","at":0.15,"state":"grieve","say":"I have seen no one."},{"actor":"me","at":0.4,"yaw":90,"state":"grieve"},{"world":{"skyColor":"#a4b2c4","fogDensity":0.019,"ambient":"#4a5470","sunIntensity":0.55}},{"at":0.7,"effect":"blur"}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"A warm crowded party that curdles into private horror as the body quietly comes apart.","world":{"s