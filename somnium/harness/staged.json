:1,"pos":[12,0,56],"yaw":-90,"hidden":true,"detail":{"second":"#4a3b34"}},{"id":"town_house_4","kind":"house","label":"","color":"#6a5d52","size":1,"pos":[-12,0,66],"yaw":90,"hidden":true,"detail":{"second":"#4a3b34"}},{"id":"town_church","kind":"church","label":"","color":"#8a8377","size":1,"pos":[13,0,70],"yaw":-90,"hidden":true}],"beats":[{"dur":8,"text":"I am walking or trotting along a path or sidewalk, hurrying to reach a certain town which is a suburb of London.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":160},"actions":[{"actor":"me","move":[0,0,-14],"path":"line","yaw":0,"state":"walk"}]},{"dur":6,"text":"It is still dark (I wish to reach my destination by sun-up)","camera":{"mode":"fixed","target":"me","pos":[7,4.5,-24],"lookAt":[-4,6,20]},"actions":[{"actor":"me","move":[0,0,-8],"path":"line","yaw":0,"state":"walk"},{"world":{"fogDensity":0.024,"ambient":"#3a4060","sunIntensity":0.42}}]},{"dur":8,"text":"and I can't see the ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":5.5,"height":2,"angle":175},"actions":[{"actor":"me","move":[0.4,0,0.2],"path":"arc","yaw":10,"state":"walk"},{"effect":"blur","at":0.25},{"world":{"fogColor":"#12182b","fogDensity":0.028}}]},{"dur":7,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":70},"actions":[{"actor":"the_boy","for":0.25,"yaw":180,"state":"idle","appear":true},{"actor":"me","for":0.6,"move":[0,0,1.8],"path":"line","yaw":20,"state":"walk"},{"actor":"me","at":0.6,"state":"idle"},{"world":{"fogDensity":0.022}}]},{"dur":8,"text":"He says he has seen me before and remembers especially the big lens on my camera.","camera":{"mode":"orbit","target":"the_boy","distance":5,"height":2.2,"angle":30},"actions":[{"actor":"my_camera","at":0.3,"for":0.25,"appear":true},{"actor":"the_big_lens","at":0.35,"for":0.25,"appear":true},{"actor":"the_boy","at":0.05,"state":"wave","say":"I have seen you before — the big lens on your camera"},{"effect":"pulse","at":0.4}]},{"dur":6,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"orbit","target":"the_boy","distance":4,"height":1.9,"angle":15},"actions":[{"actor":"the_boy","state":"idle","say":"I'll bet you are not bothered by poor light."},{"actor":"the_big_lens","at":0.3,"size":0.26},{"world":{"ambient":"#454d70"}}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"wide","target":"me","distance":16,"height":6,"angle":120},"actions":[{"actor":"someone","at":0.1,"for":0.25,"state":"idle","appear":true,"say":"You have now reached the town"},{"actor":"town_house_1","at":0.3,"for":0.25,"appear":true},{"actor":"town_house_2","at":0.32,"for":0.25,"appear":true},{"actor":"town_shop","at":0.34,"for":0.25,"appear":true},{"actor":"town_house_3","at":0.36,"for":0.25,"appear":true},{"actor":"town_house_4","at":0.38,"for":0.25,"appear":true},{"actor":"town_church","at":0.4,"for":0.25,"appear":true},{"actor":"me","yaw":0,"state":"idle"},{"world":{"sky":"dawn","skyColor":"#5b6ba4","horizonColor":"#f0a86b","fogColor":"#c2a08c","fogDensity":0.012,"ambient":"#6d7290","sunColor":"#ffd9a0","sunIntensity":1.3,"stars":false}},{"effect":"flash","at":0.45}]}]}}