,40],"yaw":90,"hidden":true,"glow":true,"detail":{"text":"OPEN","second":"#c8a15a"}},{"id":"town_house_3","kind":"house","label":"","color":"#5f5a52","size":1,"pos":[11,0,43],"yaw":270,"hidden":true,"detail":{"second":"#403830"}},{"id":"town_house_4","kind":"house","label":"","color":"#6b6255","size":1,"pos":[-11,0,53],"yaw":90,"hidden":true,"detail":{"second":"#453a2f"}}],"beats":[{"dur":7,"text":"I am walking or trotting along a path or sidewalk,","camera":{"mode":"follow","target":"me","distance":7,"height":2.6,"angle":170},"actions":[{"actor":"me","move":[0,0,-18],"path":"line","yaw":0,"state":"walk"},{"actor":"lens","move":[0.45,1.15,-17.7],"path":"line"}]},{"dur":7,"text":"hurrying to reach a certain town which is a suburb of London.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":180},"actions":[{"actor":"me","move":[0,0,-9.5],"path":"line","yaw":0,"state":"run"},{"actor":"lens","move":[0.45,1.15,-9.2],"path":"line"}]},{"dur":7,"text":"It is still dark (I wish to reach my destination by sun-up)","camera":{"mode":"fixed","target":"me","pos":[8,4,-17],"lookAt":"me"},"actions":[{"actor":"me","move":[0,0,-4],"path":"line","yaw":0,"state":"walk"},{"actor":"lens","move":[0.45,1.15,-3.7],"path":"line"},{"world":{"skyColor":"#0a1029","fogDensity":0.018,"ambient":"#3a4060"}}]},{"dur":8,"text":"and I can't see the ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":5,"height":1.5,"angle":160},"actions":[{"actor":"me","move":[0.6,0,3.5],"path":"arc","yaw":0,"state":"walk"},{"actor":"lens","move":[1.05,1.15,3.8],"path":"arc"},{"actor":"puddle_3","at":0.5,"color":"#38466a"},{"effect":"blur","at":0.55}]},{"dur":8,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"orbit","target":"me","distance":6,"height":2.2,"angle":90},"actions":[{"actor":"boy","for":0.25,"yaw":180,"state":"idle","appear":true},{"actor":"me","for":0.7,"move":[0.4,0,7.6],"path":"line","yaw":20,"state":"walk"},{"actor":"lens","for":0.7,"move":[0.85,1.15,7.9],"path":"line"},{"actor":"me","at":0.75,"state":"idle"}]},{"dur":9,"text":"He says he has seen me before and remembers especially the big lens on my camera.","camera":{"mode":"fixed","target":"me","pos":[-4.5,2.2,5.5],"lookAt":[1,1.3,8.4]},"actions":[{"actor":"boy","at":0.05,"for":0.4,"state":"wave","say":"I have seen you before"},{"actor":"lens","at":0.5,"size":0.32},{"actor":"me","yaw":25,"state":"idle"},{"effect":"pulse","at":0.55}]},{"dur":8,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"orbit","target":"boy","distance":4.5,"height":1.8,"angle":20},"actions":[{"actor":"boy","at":0.05,"state":"idle","say":"I'll bet you are not bothered by poor light."},{"actor":"lens"},{"world":{"fogDensity":0.012,"ambient":"#4a5378","sunIntensity":0.7}}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"follow","target":"me","distance":9,"height":3.4,"angle":165},"actions":[{"actor":"someone","for":0.25,"yaw":150,"state":"idle","appear":true},{"actor":"town_house_1","at":0.15,"for":0.25,"appear":true},{"actor":"town_house_2","at":0.15,"for":0.25,"appear":true},{"actor":"town_shop","at":0.2,"for":0.25,"appear":true},{"actor":"town_house_3","at":0.2,"for":0.25,"appear":true},{"actor":"town_house_4","at":0.25,"for":0.25,"appear":true},{"actor":"town_sign","at":0.25,"for":0.25,"appear":true},{"actor":"someone","at":0.35,"say":"You have now reached the town"},{"actor":"me","at":0.45,"move":[0,0,14],"path":"line","yaw":0,"state":"walk"},{"actor":"lens","at":0.45,"move":[0.45,1.15,14.3],"path":"line"},{"world":{"skyColor":"#131c3c","horizonColor":"#3b4360","ambient":"#4d5578","sunIntensity":0.8}}]}]}}