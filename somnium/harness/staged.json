,"color":"#dfe6ff","size":1,"pos":[-0.19,8,26.52],"yaw":0,"glow":true},{"id":"town_house_1","kind":"house","label":"the town, a suburb of London","color":"#5a5148","size":1,"pos":[-12,0,24],"yaw":90,"detail":{"second":"#3a3038"}},{"id":"town_house_2","kind":"house","label":"","color":"#565049","size":1,"pos":[12,0,26],"yaw":270,"detail":{"second":"#3a3038"}},{"id":"town_house_3","kind":"house","label":"","color":"#4f4a45","size":1,"pos":[-12,0,38],"yaw":90,"detail":{"second":"#38303a"}},{"id":"town_shop","kind":"shop","label":"","color":"#524b46","size":1,"pos":[12,0,40],"yaw":270,"detail":{"text":"OPEN","second":"#c9a45c"}},{"id":"town_house_4","kind":"house","label":"","color":"#4c4741","size":1,"pos":[-12,0,52],"yaw":90,"detail":{"second":"#38303a"}},{"id":"town_house_5","kind":"house","label":"","color":"#4c4741","size":1,"pos":[12,0,54],"yaw":270,"detail":{"second":"#38303a"}},{"id":"lamp_a","kind":"lamp","label":"","color":"#3b3f4a","size":1,"pos":[-2.6,0,20],"yaw":0,"glow":true,"detail":{"height":4}},{"id":"lamp_b","kind":"lamp","label":"","color":"#3b3f4a","size":1,"pos":[2.6,0,34],"yaw":0,"glow":true,"detail":{"height":4}},{"id":"roadside_tree","kind":"tree","label":"","color":"#2c3a2c","size":1,"pos":[-5.5,0,-8],"yaw":0},{"id":"roadside_bush","kind":"bush","label":"","color":"#27351f","size":1,"pos":[4.6,0,-20],"yaw":0}],"beats":[{"dur":8,"text":"I am walking or trotting along a path or sidewalk, hurrying to reach a certain town which is a suburb of London.","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":180},"actions":[{"actor":"me","move":[0,0,-29],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"It is still dark (I wish to reach my destination by sun-up)","camera":{"mode":"wide","target":"me","distance":26,"height":8,"angle":165},"actions":[{"actor":"me","move":[0,0,-18],"path":"line","yaw":0,"state":"walk"},{"world":{"skyColor":"#0b1129","horizonColor":"#26305a","ambient":"#3a4060","sunIntensity":0.5}}]},{"dur":9,"text":"and I can't see the ground clearly enough to avoid the occasional puddles of water.","camera":{"mode":"follow","target":"me","distance":5,"height":4.5,"angle":200},"actions":[{"actor":"puddle_a","for":0.25,"appear":true},{"actor":"puddle_b","at":0.1,"for":0.25,"appear":true},{"actor":"puddle_c","at":0.2,"for":0.25,"appear":true},{"actor":"me","move":[0,0,-9],"path":"arc","yaw":0,"state":"walk"},{"world":{"fogColor":"#161c3a","fogDensity":0.028,"ambient":"#3a4060"}},{"effect":"blur","at":0.35}]},{"dur":8,"text":"I meet a boy, 8 or 10 years old, and stop to talk with him.","camera":{"mode":"follow","target":"me","distance":7,"height":2.5,"angle":205},"actions":[{"actor":"boy","at":0.05,"for":0.25,"appear":true},{"actor":"me","for":0.6,"move":[0,0,-6],"path":"line","yaw":20,"state":"walk"},{"actor":"me","at":0.6,"state":"idle"},{"actor":"boy","yaw":190,"state":"idle"},{"world":{"fogColor":"#1a2142","fogDensity":0.02}}]},{"dur":7,"text":"He says he has seen me before","camera":{"mode":"fixed","target":"boy","pos":[5.5,2.2,-9.5],"lookAt":"boy"},"actions":[{"actor":"boy","at":0.1,"state":"wave","say":"I've seen you before"},{"actor":"me","state":"idle"}]},{"dur":8,"text":"and remembers especially the big lens on my camera.","camera":{"mode":"orbit","target":"me","distance":4,"height":2,"angle":40},"actions":[{"actor":"boy","at":0.1,"state":"idle","say":"especially the big lens on your camera"},{"actor":"big_lens","at":0.3,"size":0.32},{"actor":"me","state":"idle"},{"effect":"pulse","at":0.35}]},{"dur":7,"text":"He says, \"I'll bet you are not bothered by poor light.\"","camera":{"mode":"fixed","target":"boy","pos":[-5.5,2,-9],"lookAt":"boy"},"actions":[{"actor":"boy","at":0.05,"state":"idle","say":"I'll bet you are not bothered by poor light."},{"actor":"me","state":"idle"},{"world":{"fogDensity":0.016,"ambient":"#454d76","sunIntensity":0.8}}]},{"dur":10,"text":"Someone then tells me I have now reached the town.","camera":{"mode":"follow","target":"me","distance":9,"height":3.5,"angle":190},"actions":[{"actor":"me","for":0.75,"move":[0,0,14],"path":"line","yaw":0,"state":"run"},{"actor":"me","at":0.75,"state":"idle"},{"actor":"boy","at":0.2,"for":0.25,"vanish":true},{"actor":"someone","at":0.7,"for":0.25,"appear":true},{"actor":"someone","at":0.8,"state":"idle","say":"You have now reached the town"},{"world":{"skyColor":"#152046","horizonColor":"#3a4472","fogDensity":0.014,"ambient":"#454d76","sunIntensity":0.9}}]}]}}