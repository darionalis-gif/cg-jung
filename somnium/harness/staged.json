 we walked bravely.","camera":{"mode":"follow","target":"me","distance":8,"height":2.8,"angle":150},"actions":[{"actor":"rifle","at":0.1,"for":0.25,"appear":true},{"actor":"me","move":[-5.5,0,70.2],"path":"line","yaw":-85,"state":"walk"},{"actor":"steve","move":[-6.6,0,71.6],"path":"line","yaw":-85,"state":"walk"},{"world":{"fogDensity":0.014,"ambient":"#5c6180","sunColor":"#ffd7a0","sunIntensity":0.9}}]}]},"natural_scientist-203":{"title":"Hurrying to the Suburb Before Sun-Up","mood":"A dark, urgent walk that softens into an odd, kindly recognition from a child.","world":{"sky":"night","skyColor":"#141a2b","horizonColor":"#2a3350","fogColor":"#1b2233","fogDensity":0.022,"ground":"soil","groundColor":"#2e2c35","ambient":"#3f4668","sunColor":"#9fb0d8","sunIntensity":0.5,"sunDir":[-0.3,0.6,-0.85],"weather":"none","stars":true},"actors":[{"id":"me","kind":"person","label":"me","color":"#5b6b8c","size":1,"pos":[0,0,-20],"yaw":0,"detail":{"wear":"jacket","wearColor":"#3d4a63","skin":"#c98f6a","hair":"#2a2118"}},{"id":"my_camera","kind":"box","label":"my camera","color":"#1e2027","size":0.2,"pos":[0,0,-20],"yaw":0,"carriedBy":"me"},{"id":"big_lens","kind":"lens","label":"the big lens on my camera","color":"#20242c","size":0.35,"pos":[0,0,-20],"yaw":0,"carriedBy":"me","detail":{"second":"#a8c6e8"}},{"id":"the_path","kind":"path","label":"the path or sidewalk","color":"#585460","size":1,"pos":[0,0,8],"yaw":0,"detail":{"width":2.6,"depth":120}},{"id":"moon","kind":"moon","label":"","color":"#dfe6f5","size":1.1,"pos":[12,22,90],"yaw":0,"glow":true},{"id":"puddle_1","kind":"water","label":"a puddle of water","color":"#2c3a55","size":0.1,"pos":[1.4,0,-6],"yaw":0,"hidden":true,"detail":{"radius":10}},{"id":"puddle_2","kind":"water","label":"","color":"#2c3a55","size":0.1,"pos":[-1.5,0,1],"yaw":0,"hidden":true,"detail":{"radius":9}},{"id":"puddle_3","kind":"water","label":"","color":"#2c3a55","size":0.1,"pos":[1.3,0,7],"yaw":0,"hidden":true,"detail":{"radius":11}},{"id":"boy","ki