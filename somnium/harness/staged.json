{"alta-263":{"title":"The Man Who Picked Me","mood":"Bewildered, cornered by a stranger's anger for no reason at all, in a town too empty to help.","world":{"sky":"dusk","skyColor":"#4b5570","horizonColor":"#96806e","fogColor":"#6b6f80","fogDensity":0.012,"ground":"stone","groundColor":"#5d5f63","ambient":"#4a4e66","sunColor":"#e0b384","sunIntensity":0.8,"sunDir":[-0.35,0.4,-0.85],"weather":"none","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#5b7fa6","size":1,"pos":[0,0,-14],"yaw":0,"detail":{"skin":"#d8ae8c","hair":"#3a2c22"}},{"id":"loud_man","kind":"person","label":"the loud man in a raincoat","color":"#6a5f52","size":1.1,"pos":[2.2,0,9],"yaw":180,"hidden":true,"detail":{"wear":"raincoat","wearColor":"#3f4a3c","skin":"#c99f7d","hair":"#2a2420"}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#7a7488","size":1,"pos":[-7.5,0,-3],"yaw":90,"hidden":true,"detail":{"count":3,"radius":2}},{"id":"street","kind":"road","label":"","color":"#4c4e52","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":8,"depth":120}},{"id":"corner_street","kind":"road","label":"","color":"#4c4e52","size":1,"pos":[0,0,13],"yaw":90,"detail":{"width":8,"depth":80}},{"id":"shop_a","kind":"shop","label":"shops","color":"#8a7b6b","size":1,"pos":[-12,0,-2],"yaw":90,"detail":{"text":"SHOP"}},{"id":"shop_b","kind":"shop","label":"","color":"#7d6f78","size":1,"pos":[-12,0,-16],"yaw":90,"detail":{"text":"CAFE"}},{"id":"shop_c","kind":"shop","label":"","color":"#87796a","size":1,"pos":[12,0,-8],"yaw":270,"detail":{"text":"GROCER"}},{"id":"shop_d","kind":"shop","label":"","color":"#6f6f7c","size":1,"pos":[12,0,6],"yaw":270,"detail":{"text":"BAKERY"}},{"id":"shop_e","kind":"shop","label":"","color":"#7f7264","size":1,"pos":[-12,0,8],"yaw":90,"detail":{"text":"HARDWARE"}},{"id":"lamp_a","kind":"lamp","label":"street lamps","color":"#3b3b40","size":1,"pos":[-5.5,0,-16],"yaw":90,"detail":{"height":4}},{"id":"lamp_b","kind":"lamp","label":"","color":"#3b3b40","size":1,"pos":[5.5,0,-6],"yaw":270,"detail":{"height":4}},{"id":"lamp_c","kind":"lamp","label":"","color":"#3b3b40","size":1,"pos":[-5.5,0,2],"yaw":90,"detail":{"height":4}},{"id":"lamp_d","kind":"lamp","label":"","color":"#3b3b40","size":1,"pos":[5.5,0,11],"yaw":270,"detail":{"height":4}}],"beats":[{"dur":7,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":22,"height":9,"angle":160},"actions":[{"actor":"me","yaw":0,"state":"idle"}]},{"dur":6,"text":"There are shops, etc., and street lamps.","camera":{"mode":"fixed","target":"me","pos":[0,4.5,-24],"lookAt":[0,2,-2]},"actions":[{"actor":"me","move":[0,0,-10],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"I'm walking down the street, about to turn a corner, and I'm confronted by a loud man in a raincoat","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":175},"actions":[{"actor":"me","move":[0,0,4],"path":"line","yaw":0,"state":"walk"},{"actor":"loud_man","at":0.1,"move":[0.6,0,6.6],"path":"line","yaw":180,"state":"walk","appear":true}]},{"dur":7,"text":"- he's really mad about something but I don't know what.","camera":{"mode":"orbit","target":"loud_man","distance":6,"height":2.4,"angle":20},"actions":[{"actor":"loud_man","yaw":180,"state":"yell"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"fogColor":"#5d5560","ambient":"#474459","sunIntensity":0.65}}]},{"dur":8,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder","camera":{"mode":"fixed","target":"me","pos":[7,2.6,5.4],"lookAt":"me"},"actions":[{"actor":"me","move":[0,0,5],"yaw":0,"state":"idle"},{"actor":"loud_man","for":0.4,"move":[0.5,0,5.9],"yaw":180,"state":"yell"},{"actor":"loud_man","at":0.4,"yaw":180,"state":"push"},{"at":0.45,"effect":"quake"}]},{"dur":6,"text":"- he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"loud_man","distance":5.5,"height":2.2,"angle":25},"actions":[{"actor":"loud_man","yaw":180,"state":"pockets"},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":8,"text":"I retreat up the street a bit - there are some people out watching.","camera":{"mode":"follow","target":"me","distance":10,"height":3.5,"angle":170},"actions":[{"actor":"me","move":[0,0,-6],"path":"line","yaw":180,"state":"walk"},{"actor":"watchers","at":0.12,"for":0.25,"yaw":90,"state":"idle","appear":true},{"actor":"loud_man","yaw":180,"state":"yell"}]},{"dur":7,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"fixed","target":"watchers","pos":[6.5,3,-5],"lookAt":"watchers"},"actions":[{"actor":"watchers","yaw":90,"state":"idle"},{"actor":"me","yaw":180,"state":"idle"},{"world":{"skyColor":"#3f4762","fogDensity":0.016}}]},{"dur":9,"text":"He follows and keeps yelling at me - some of the time he yells around in general but it's mostly at me","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":170},"actions":[{"actor":"me","move":[0,0,-9],"path":"line","yaw":180,"state":"walk"},{"actor":"loud_man","for":0.5,"move":[1,0,-4.5],"path":"line","yaw":160,"state":"yell"},{"actor":"loud_man","at":0.5,"yaw":250,"state":"yell"},{"actor":"watchers","yaw":100}]},{"dur":9,"text":"- I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"orbit","target":"me","distance":7,"height":2.4,"angle":15},"actions":[{"actor":"me","yaw":180,"state":"grieve"},{"actor":"loud_man","move":[1.2,0,-7],"path":"line","yaw":170,"state":"yell"},{"world":{"fogColor":"#565064","fogDensity":0.02,"ambient":"#3f4260","sunIntensity":0.5}},{"at":0.75,"effect":"pulse"}]}]},"vietnam_vet-89":{"title":"Sick Call in the Snow","mood":"Numb, aching loyalty in a white waste where no one listens.","world":{"sky":"overcast","skyColor":"#b7c2ce","horizonColor":"#d5dde5","fogColor":"#ccd6df","fogDensity":0.008,"ground":"snow","groundColor":"#e7edf3","ambient":"#6b7488","sunColor":"#e0e8f4","sunIntensity":0.9,"sunDir":[0.3,0.7,-0.4],"weather":"snow","stars":false},"actors":[{"id":"me","kind":"person","label":"me","color":"#a9ada5","size":1,"pos":[-1.44,0,-1.08],"yaw":0,"detail":{"wear":"uniform","wearColor":"#a9ada5","skin":"#d8b08c","hair":"#3a2c1e"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#4f5943","size":1,"pos":[4,0,3],"yaw":0,"detail":{"count":14,"radius":5}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#8b9668","size":1,"pos":[-3,0,5],"yaw":0,"hidden":true,"detail":{"wear":"uniform","wearColor":"#8b9668","skin":"#e0bb95","hair":"#6b4a2a"}},{"id":"antarctica","kind":"mountain","label":"Antarctica","color":"#c3ccd6","size":1,"pos":[-40,0,150],"yaw":0},{"id":"far_peaks","kind":"mountain","label":"","color":"#bcc6d1","size":0.8,"pos":[70,0,165],"yaw":20},{"id":"aid_station","kind":"house","label":"the aid station","color":"#cfd3d8","size":1,"pos":[0,0,26],"yaw":180,"hidden":true,"detail":{"second":"#7c8794"}},{"id":"staff","kind":"crowd","label":"the staff","color":"#c8ccd2","size":1,"pos":[1,0,21],"yaw":180,"hidden":true,"detail":{"count":4,"radius":2}},{"id":"medic","kind":"person","label":"the kind, middle-aged black medic","color":"#8e9a86","size":1,"pos":[-3.5,0,17.5],"yaw":135,"hidden":true,"detail":{"wear":"uniform","wearColor":"#8e9a86","skin":"#4a3226","hair":"#1a1512"}}],"beats":[{"dur":9,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"wide","target":"me","distance":30,"height":10,"angle":180},"actions":[{"actor":"me","move":[0,0,4],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[4,0,7],"path":"line","yaw":0,"state":"walk"}]},{"dur":7,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"follow","target":"me","distance":8,"height":2.5,"angle":45},"actions":[{"actor":"timmy","at":0.1,"move":[-3,0,7],"path":"line","yaw":0,"state":"limp","appear":true},{"actor":"me","yaw":300,"state":"pockets"},{"actor":"platoon","yaw":0,"state":"idle"}]},{"dur":12,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"follow","target":"me","distance":9,"height":3,"angle":150},"actions":[{"actor":"aid_station","at":0.1,"for":0.25,"appear":true},{"actor":"me","move":[-1,0,18],"path":"line","yaw":0,"state":"walk"},{"actor":"platoon","move":[3,0,17],"path":"line","yaw":0,"state":"limp"},{"actor":"timmy","move":[-4,0,16],"path":"line","yaw":0,"state":"limp"},{"world":{"fogDensity":0.011,"sunIntensity":0.75}}]},{"dur":9,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"fixed","target":"me","pos":[11,3,19],"lookAt":[1,1.4,20]},"actions":[{"actor":"staff","at":0.1,"for":0.25,"yaw":180,"state":"yell","appear":true},{"actor":"platoon","move":[1,0,18.5],"path":"line","yaw":0,"state":"walk"},{"actor":"me","move":[-2,0,16],"path":"line","yaw":0,"state":"walk"},{"actor":"timmy","yaw":0,"state":"idle"}]},{"dur":9,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"orbit","target":"me","distance":6,"height":2.5,"angle":20},"actions":[{"actor":"me","yaw":0,"state":"grieve"},{"actor":"staff","yaw":180,"state":"yell"},{"actor":"platoon","state":"idle"},{"world":{"skyColor":"#96a3b2","horizonColor":"#b6c1cc","fogColor":"#b3bec9","fogDensity":0.016,"ambient":"#5a6480","sunIntensity":0.6}},{"at":0.5,"effect":"pulse"}]},{"dur":11,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"follow","target":"me","distance":7,"height":2.5,"angle":40},"actions":[{"actor":"medic","at":0.1,"for":0.25,"yaw":135,"state":"idle","appear":true},{"actor":"medic","at":0.25,"yaw":-161.57,"say":"Timmy D. will go home."},{"actor":"me","yaw":315,"state":"idle"},{"actor":"timmy","yaw":45,"state":"idle"},{"world":{"ambient":"#6d7690","sunIntensity":0.8}}]},{"dur":10,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"follow","target":"me","distance":6,"height":2.2,"angle":50},"actions":[{"actor":"me","move":[-2.2,0,16],"path":"line","yaw":270,"state":"walk"},{"actor":"timmy","yaw":90,"state":"grieve"},{"actor":"timmy","at":0.35,"yaw":18.43,"say":"I have been denied sick call."},{"actor":"medic","yaw":200,"state":"idle"}]},{"dur":8,"text":"He has seen no one.","camera":{"mode":"orbit","target":"timmy","distance":5.5,"height":2.4,"angle":25},"actions":[{"actor":"timmy","at":0.15,"say":"I have seen no one."},{"actor":"timmy","yaw":90,"state":"grieve"},{"actor":"staff","at":0.3,"for":0.25,"vanish":true},{"world":{"skyColor":"#8b98a8","fogColor":"#a8b3bf","fogDensity":0.02,"ambient":"#525c78","sunIntensity":0.5}},{"at":0.6,"effect":"pulse"}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"A warm crowded party turning slowly to helpless shame as the mouth comes apart.","world":{"sky":"night","skyColor":"#1a1626","horizonColor":"#33283a","fogColor":"#2a2230","fogDensity":0.012,"ground":"floor","groundColor":"#7a5f4a","ambient":"#5a5068","sunColor":"#ffd9a8","sunIntensity":0.9,"sunDir":[0.3,0.8,-0.4],"weather":"none","stars":false},"actors":[{"id":"hall","kind":"room","label":"","color":"#6b5a4e","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":24,"depth":20,"height":4.5,"second":"#c9b79a"}},{"id":"tea_table","kind":"table","label":"an extremely long tea table","color":"#8b6b4a","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":14,"depth":1.4,"second":"#efe6d2"}},{"id":"teapot","kind":"thing","label":"the tea","color":"#d8d2c4","size":0.5,"pos":[1.6,0.76,0],"yaw":0},{"id":"cakes","kind":"food","label":"","color":"#e8c98a","size":1,"pos":[-2.6,0.76,0],"yaw":0},{"id":"cakes_two","kind":"food","label":"","color":"#e8c98a","size":1,"pos":[4.2,0.76,0],"yaw":0},{"id":"table_candle","kind":"candle","label":"","color":"#f5efdc","size":1,"pos":[-0.9,0.76,0.1],"yaw":0,"glow":true},{"id":"me","kind":"person","label":"me","color":"#aaafc2","size":1,"pos":[0.07195192381189225,0,-1.201728752716183],"yaw":