{"alta-263":{"title":"The Man in the Raincoat","mood":"A grey, ordinary street turned suddenly hostile for no reason you can name.","world":{"sky":"overcast","skyColor":"#9aa3ad","horizonColor":"#b3b9bf","fogColor":"#a8aeb5","fogDensity":0.012,"ground":"road","groundColor":"#7b7f84","ambient":"#6a7080","sunColor":"#d8dce0","sunIntensity":0.8,"sunDir":[-0.3,0.8,0.4],"weather":"none","stars":false},"actors":[{"id":"main_street","kind":"road","label":"","color":"#6f747a","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":8,"depth":120}},{"id":"corner_street","kind":"road","label":"the corner","color":"#6f747a","size":1,"pos":[0,0,12],"yaw":90,"detail":{"width":8,"depth":120}},{"id":"shop_a","kind":"shop","label":"a shop","color":"#8d8377","size":1,"pos":[-9,0,-18],"yaw":90,"detail":{"text":"GROCER","second":"#5c6b74"}},{"id":"shop_b","kind":"shop","label":"a shop","color":"#7d7f8a","size":1,"pos":[-9,0,-8],"yaw":90,"detail":{"text":"BAKERY","second":"#6d5f52"}},{"id":"shop_c","kind":"shop","label":"a shop","color":"#8a7d7d","size":1,"pos":[-9,0,2],"yaw":90,"detail":{"text":"HARDWARE","second":"#4f5a63"}},{"id":"shop_d","kind":"shop","label":"a shop","color":"#7f8478","size":1,"pos":[9,0,-14],"yaw":270,"detail":{"text":"CHEMIST","second":"#5e6a58"}},{"id":"shop_e","kind":"shop","label":"a shop","color":"#87817a","size":1,"pos":[9,0,-4],"yaw":270,"detail":{"text":"CAFE","second":"#6a5b57"}},{"id":"corner_shop","kind":"shop","label":"the shop on the corner","color":"#8b8478","size":1,"pos":[-9,0,20],"yaw":90,"detail":{"text":"NEWS","second":"#59636b"}},{"id":"lamp_1","kind":"lamp","label":"a street lamp","color":"#4a4f55","size":1,"pos":[-5,0,-14],"yaw":90,"detail":{"height":4}},{"id":"lamp_2","kind":"lamp","label":"a street lamp","color":"#4a4f55","size":1,"pos":[-5,0,-3],"yaw":90,"detail":{"height":4}},{"id":"lamp_3","kind":"lamp","label":"a street lamp","color":"#4a4f55","size":1,"pos":[-5,0,8],"yaw":90,"detail":{"height":4}},{"id":"lamp_4","kind":"lamp","label":"a street lamp","color":"#4a4f55","size":1,"pos":[5,0,-9],"yaw":270,"detail":{"height":4}},{"id":"lamp_5","kind":"lamp","label":"a street lamp","color":"#4a4f55","size":1,"pos":[5,0,3],"yaw":270,"detail":{"height":4}},{"id":"me","kind":"person","label":"me","color":"#4c5f7a","size":1,"pos":[-1,0,-12],"yaw":0,"detail":{"skin":"#d8b291","hair":"#4a3a2e"}},{"id":"loud_man","kind":"person","label":"the loud man in a raincoat","color":"#3e4348","size":1.15,"pos":[-1,0,9],"yaw":180,"hidden":true,"detail":{"wear":"raincoat","wearColor":"#6b6a3c","skin":"#c8a184","hair":"#3b3530"}},{"id":"watchers","kind":"crowd","label":"some people out watching","color":"#6c6f75","size":1,"pos":[6.5,0,-9],"yaw":-68,"hidden":true,"detail":{"count":3,"radius":1.5}}],"beats":[{"dur":7,"text":"I'm on an almost-empty street in a small town.","camera":{"mode":"wide","target":"me","distance":24,"height":9,"angle":200},"actions":[{"actor":"me","yaw":0,"state":"idle"}]},{"dur":7,"text":"There are shops, etc., and street lamps.","camera":{"mode":"fixed","target":"me","pos":[0,6,-26],"lookAt":[0,2,2]},"actions":[{"actor":"me","state":"idle"}]},{"dur":8,"text":"I'm walking down the street, about to turn a corner,","camera":{"mode":"follow","target":"me","distance":8,"height":3,"angle":200},"actions":[{"actor":"me","move":[-1,0,4],"path":"line","yaw":0,"state":"walk"}]},{"dur":8,"text":"and I'm confronted by a loud man in a raincoat - he's really mad about something but I don't know what.","camera":{"mode":"follow","target":"me","distance":8,"height":2.6,"angle":95},"actions":[{"actor":"loud_man","at":0.1,"for":0.25,"appear":true},{"actor":"loud_man","at":0.15,"for":0.5,"move":[-1,0,5.2],"path":"line","yaw":180,"state":"walk"},{"actor":"loud_man","at":0.7,"state":"yell"},{"actor":"me","yaw":0,"state":"idle"},{"world":{"fogDensity":0.016,"ambient":"#5e6472"}}]},{"dur":9,"text":"He just stands and yells at me, sometimes shoving with his elbow and shoulder","camera":{"mode":"follow","target":"me","distance":6,"height":2.2,"angle":100},"actions":[{"actor":"loud_man","yaw":180,"state":"yell"},{"actor":"loud_man","at":0.45,"for":0.25,"state":"push"},{"actor":"me","at":0.5,"for":0.3,"state":"shake"},{"effect":"pulse","at":0.5}]},{"dur":6,"text":"- he's got his hands stuck in his pockets.","camera":{"mode":"orbit","target":"loud_man","distance":5,"height":2,"angle":40},"actions":[{"actor":"loud_man","state":"pockets"},{"actor":"me","state":"idle"}]},{"dur":9,"text":"I retreat up the street a bit - there are some people out watching.","camera":{"mode":"follow","target":"me","distance":9,"height":3.4,"angle":120},"actions":[{"actor":"me","move":[-1,0,-6],"path":"line","yaw":180,"state":"walk"},{"actor":"watchers","at":0.12,"for":0.25,"appear":true},{"actor":"watchers","yaw":-68,"state":"idle"},{"actor":"loud_man","state":"yell"}]},{"dur":7,"text":"I guess they think I had something to do with this guy.","camera":{"mode":"orbit","target":"watchers","distance":8,"height":3,"angle":50},"actions":[{"actor":"watchers","yaw":-68,"state":"idle"},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":10,"text":"He follows and keeps yelling at me - some of the time he yells around in general but it's mostly at me","camera":{"mode":"follow","target":"me","distance":8,"height":2.8,"angle":95},"actions":[{"actor":"loud_man","for":0.5,"move":[-1,0,-4.2],"path":"line","yaw":180,"state":"walk"},{"actor":"loud_man","at":0.5,"state":"yell"},{"actor":"loud_man","at":0.6,"for":0.15,"yaw":250},{"actor":"loud_man","at":0.8,"yaw":180},{"actor":"me","yaw":0,"state":"idle"},{"actor":"watchers","state":"idle"}]},{"dur":9,"text":"- I don't know him and definitely didn't do anything to start this, it seems he's just picked me because I'm handy.","camera":{"mode":"orbit","target":"me","distance":7,"height":3,"angle":40},"actions":[{"actor":"loud_man","yaw":180,"state":"yell"},{"actor":"me","yaw":0,"state":"grieve"},{"world":{"skyColor":"#8b929b","fogDensity":0.022,"ambient":"#565c6c","sunIntensity":0.6}}]}]},"vietnam_vet-89":{"title":"Sick Call in Antarctica","mood":"Frozen, aching endurance and the loneliness of suffering that no one records.","world":{"sky":"overcast","skyColor":"#b9c6d6","horizonColor":"#dbe5ee","fogColor":"#cdd9e4","fogDensity":0.011,"ground":"snow","groundColor":"#e6eef6","ambient":"#4a5470","sunColor":"#dfe8f2","sunIntensity":0.75,"sunDir":[0.3,0.7,0.25],"weather":"snow","stars":false},"actors":[{"id":"antarctica","kind":"field","label":"Antarctica","color":"#e9f1f8","size":1,"pos":[0,0,22],"yaw":0,"detail":{"count":26,"radius":45}},{"id":"far_peaks","kind":"mountain","label":"","color":"#dce7f1","size":1,"pos":[-45,0,185],"yaw":0},{"id":"far_peaks_east","kind":"mountain","label":"","color":"#d5e1ee","size":0.8,"pos":[70,0,165],"yaw":30},{"id":"aid_station","kind":"house","label":"the aid station","color":"#7c8a7a","size":1,"pos":[0,0,42],"yaw":180,"detail":{"second":"#5a6560"}},{"id":"sick_call_sign","kind":"sign","label":"","color":"#5c6660","size":1,"pos":[-6,0,37],"yaw":180,"detail":{"text":"SICK CALL"}},{"id":"me","kind":"person","label":"me","color":"#6d7355","size":1,"pos":[0,0,0],"yaw":0,"detail":{"wear":"uniform","wearColor":"#6d7355","skin":"#d6ab8a","hair":"#3a2b1e"}},{"id":"platoon","kind":"crowd","label":"the platoon","color":"#6a7053","size":1,"pos":[5,0,4],"yaw":0,"detail":{"count":18,"radius":5}},{"id":"staff","kind":"crowd","label":"the staff","color":"#dfe3e7","size":1,"pos":[0,0,38],"yaw":180,"hidden":true,"detail":{"count":4,"radius":2}},{"id":"medic","kind":"person","label":"a kind, middle-aged black medic","color":"#e2e6ea","size":1.05,"pos":[-7,0,32.5],"yaw":180,"hidden":true,"detail":{"wear":"uniform","wearColor":"#e2e6ea","skin":"#4a3123","hair":"#191310"}},{"id":"timmy","kind":"person","label":"Timmy D.","color":"#8d9366","size":1.05,"pos":[-4,0,30],"yaw":270,"hidden":true,"detail":{"wear":"jacket","wearColor":"#8d9366","skin":"#c9a07f","hair":"#c4a24e"}}],"beats":[{"dur":8,"text":"I am with the platoon on patrol in Antarctica.","camera":{"mode":"wide","target":"me","distance":24,"height":9,"angle":205},"actions":[{"actor":"me","move":[0,0,6],"state":"walk"},{"actor":"platoon","move":[5,0,10],"state":"walk"}]},{"dur":7,"text":"Those with foot problems are asked to go on sick call.","camera":{"mode":"fixed","target":"platoon","pos":[17,4,2],"lookAt":"platoon"},"actions":[{"actor":"platoon","yaw":0,"state":"idle"},{"actor":"me","yaw":0,"state":"idle"}]},{"dur":10,"text":"Nearly all are lame, but march to the aid station in the cold, hard snow.","camera":{"mode":"follow","target":"me","distance":10,"height":3.5,"angle":200},"actions":[{"actor":"me","move":[-2,0,28],"state":"limp"},{"actor":"platoon","move":[3,0,32],"state":"limp"},{"actor":"staff","at":0.15,"for":0.25,"appear":true},{"world":{"skyColor":"#aebbcb","fogDensity":0.014}}]},{"dur":9,"text":"They overwhelm the staff who make complaints against them.","camera":{"mode":"fixed","target":"me","pos":[15,5,31],"lookAt":[1,1.4,36]},"actions":[{"actor":"platoon","move":[2,0,35],"yaw":0,"state":"push"},{"actor":"staff","yaw":180,"state":"yell"},{"actor":"me","move":[-7,0,30],"yaw":0,"state":"walk"},{"effect":"quake","at":0.45}]},{"dur":9,"text":"I am sad because no one cares, no one understands how we suffer.","camera":{"mode":"orbit","target":"me","distance":5,"height":2,"angle":25},"actions":[{"actor":"me","state":"grieve"},{"world":{"skyColor":"#9daaba","fogDensity":0.02,"ambient":"#414a66","sunIntensity":0.55}},{"effect":"pulse","at":0.3}]},{"dur":11,"text":"A kind, middle-aged black medic tells me that Timmy D., whose bad feet should have kept him out of the Army, will go home.","camera":{"mode":"fixed","target":"me","pos":[-16,3,31.5],"lookAt":[-7,1.5,31.2]},"actions":[{"actor":"medic","at":0.1,"for":0.25,"appear":true},{"actor":"medic","at":0.25,"yaw":180,"state":"idle","say":"Timmy D. will go home."},{"actor":"me","yaw":0,"state":"idle"},{"world":{"fogDensity":0.014,"ambient":"#4d5878","sunIntensity":0.8}}]},{"dur":10,"text":"But when I speak to Timmy D., he says he has been denied sick call.","camera":{"mode":"fixed","target":"me","pos":[-5.5,2.4,38.5],"lookAt":[-5.5,1.5,30]},"actions":[{"actor":"medic","at":0.1,"for":0.25,"vanish":true},{"actor":"timmy","at":0.1,"for":0.25,"appear":true},{"actor":"me","yaw":90,"state":"idle"},{"actor":"timmy","yaw":270,"state":"limp"},{"actor":"timmy","at":0.4,"state":"grieve","say":"I have been denied sick call."}]},{"dur":8,"text":"He has seen no one.","camera":{"mode":"wide","target":"timmy","distance":17,"height":6,"angle":180},"actions":[{"actor":"staff","at":0.1,"for":0.25,"vanish":true},{"actor":"platoon","at":0.15,"for":0.25,"vanish":true},{"actor":"timmy","yaw":0,"state":"idle","say":"I have seen no one."},{"actor":"me","yaw":0,"state":"grieve"},{"world":{"skyColor":"#93a1b3","fogDensity":0.024,"ambient":"#3f4866","sunIntensity":0.5}},{"effect":"blur","at":0.6}]}]},"hall_female-365":{"title":"The Long Tea Table","mood":"A warm crowded party turning quietly to horror as the body comes apart in public.","world":{"sky":"night","skyColor":"#15121f","horizonColor":"#2b2438","fogColor":"#282133","fogDensity":0.006,"ground":"floor","groundColor":"#4a3b33","ambient":"#54486e","sunColor":"#ffd9a8","sunIntensity":0.8,"sunDir":[0.3,0.9,-0.4],"weather":"none","stars":false},"actors":[{"id":"hall","kind":"room","label":"","color":"#3d3550","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":30,"depth":22,"height":5,"second":"#6b5a48"}},{"id":"tea_table","kind":"table","label":"the extremely long tea table","color":"#c9bda4","size":1,"pos":[0,0,0],"yaw":0,"detail":{"width":12,"depth":1.2}},{"id":"tea_things","kind":"food","label":"tea things","color":"#e8e2d4","size":1,"pos":[-1.6,0.75,0],"yaw":0},{"id":"tea_things_2","kind":"food","label":"","color":"#e0d6c2","size":1,"pos":[3.4,0.75,0],"yaw":0},{"id":"table_candle","kind":"candle","label":"","color":"#f6e6b8","size":1,"pos":[1.2,0.75,0],"yaw":0,"glow":true},{"id":"me","kind":"person","label":"me","color":"#d9d2c2