g_man","state":"idle"},{"actor":"young_woman","state":"idle"}]},{"dur":8,"text":"As I started to talk to the people who were about my age (M & F 20-25)","camera":{"mode":"follow","target":"me","distance":5,"height":2.2,"angle":0},"actions":[{"actor":"me","yaw":0,"state":"wave"},{"actor":"young_man","yaw":70,"state":"idle"},{"actor":"young_woman","yaw":-70,"state":"idle"},{"actor":"guests_far","state":"idle"}]},{"dur":7,"text":"my teeth began to drop out.","camera":{"mode":"follow","target":"me","distance":3.5,"height":1.9,"angle":0},"actions":[{"actor":"tooth_1","at":0.1,"for":0.25,"appear":true},{"actor":"tooth_1","at":0.15,"for":0.5,"move":[0.35,0,-2],"path":"arc","state":"fall"},{"actor":"me","at":0.15,"state":"shake"},{"at":0.15,"effect":"pulse"}]},{"dur":10,"text":"One by one each tooth fell out","camera":{"mode":"follow","target":"me","distance":3.5,"height":1.8,"angle":0},"actions":[{"actor":"tooth_2","at":0.05,"for":0.25,"appear":true},{"actor":"tooth_2","at":0.08,"for":0.22,"move":[-0.45,0,-2.05],"path":"arc","state":"fall"},{"actor":"tooth_3","at":0.3,"for":0.25,"appear":true},{"actor":"tooth_3","at":0.33,"for":0.22,"move":[0.6,0,-2.2],"path":"arc","state":"fall"},{"actor":"tooth_4","at":0.55,"for":0.25,"appear":true},{"actor":"tooth_4","at":0.58,"for":0.22,"move":[-0.75,0,-2.25],"path":"arc","state":"fall"},{"actor":"tooth_5","at":0.75,"for":0.25,"appear":true},{"actor":"tooth_5","at":0.78,"for":0.2,"move":[0.1,0,-2.35],"path":"arc","state":"fall"},{"actor":"me","state":"shake"},{"actor":"young_woman","yaw":-70,"state":"idle"},{"actor":"young_man","yaw":70,"state":"idle"},{"world":{"fogDensity":0.016,"ambient":"#4e4866","sunIntensity":0.7}},{"at":0.55,"effect":"pulse"}]},{"dur":9,"text":"and soon my face started to fold.","camera":{"mode":"orbit","target":"me","distance":3.5,"height":2,"angle":20},"actions":[{"actor":"me","at":0.1,"state":"fold"},{"actor":"guests_far","yaw":180,"state":"idle"},{"actor":"young_man","state":"idle"},{"actor":"young_woman","s